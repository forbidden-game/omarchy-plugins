def enforce_mode(path, mode):
    """Set secure permissions, tolerating a read-only sandbox when already correct."""
    path = Path(path)
    try:
        os.chmod(path, mode)
    except OSError as exc:
        current_mode = path.stat().st_mode & 0o777 if path.exists() else None
        if exc.errno in (errno.EROFS, errno.EPERM) and current_mode == mode:
            return
        raise


def ensure_storage_migrated():
    """Ensure ~/.config/omarchy/agents/antigravity exists and auto-migrate from ~/.antigravity_tools if needed."""
    ANTIGRAVITY_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    ACCOUNTS_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    AUTH_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    enforce_mode(ANTIGRAVITY_DIR, 0o700)
    enforce_mode(ACCOUNTS_DIR, 0o700)
    enforce_mode(AUTH_DIR, 0o700)

    if not ACCOUNTS_INDEX.is_file():
        legacy_index = LEGACY_DIR / "accounts.json"
        legacy_accounts = LEGACY_DIR / "accounts"
        if legacy_index.is_file():
            try:
                shutil.copy2(legacy_index, ACCOUNTS_INDEX)
                if legacy_accounts.is_dir():
                    for f in legacy_accounts.glob("*.json"):
                        shutil.copy2(f, ACCOUNTS_DIR / f.name)
            except Exception:
                pass

    if not ACCOUNTS_INDEX.is_file():
        atomic_write(
            ACCOUNTS_INDEX,
            json.dumps({"version": "2.0", "accounts": [], "current_account_id": "", "current_target_ide": "agy"}, indent=2) + "\n",
            0o600,
        )

    for secret_file in [ACCOUNTS_INDEX, OAUTH_CONFIG_FILE, *ACCOUNTS_DIR.glob("*.json"), *AUTH_DIR.glob("*.json")]:
        if secret_file.is_file():
            enforce_mode(secret_file, 0o600)


def atomic_write(path, text, mode=0o600):
    """Write a file atomically without exposing partial or permissive content."""
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(text)
        os.chmod(temp_name, mode)
        os.replace(temp_name, path)
    finally:
        try:
            Path(temp_name).unlink(missing_ok=True)
        except Exception:
            pass


def _supported_binary_value(candidates, fingerprints, label):
    """Select one known Antigravity value without embedding it in the plugin."""
    matches = {
        candidate
        for candidate in candidates
        if hashlib.sha256(candidate).hexdigest() in fingerprints
    }
    if len(matches) != 1:
        raise RuntimeError(
            f"Installed Antigravity has no supported {label}; "
            "update the Omarvoice compatibility table"
        )
    return matches.pop().decode("ascii")


def extract_antigravity_oauth_client(
    language_server=ANTIGRAVITY_LANGUAGE_SERVER,
    client_id_hashes=SUPPORTED_OAUTH_CLIENT_ID_HASHES,
    client_secret_hashes=SUPPORTED_OAUTH_CLIENT_SECRET_HASHES,
):
    """Extract the supported OAuth client shipped inside Antigravity."""
    language_server = Path(language_server)
    if not language_server.is_file():
        raise RuntimeError("Antigravity language_server is not installed")
    with language_server.open("rb") as handle:
        with mmap.mmap(handle.fileno(), 0, access=mmap.ACCESS_READ) as binary:
            client_ids = set(OAUTH_CLIENT_ID_PATTERN.findall(binary))
            client_secrets = set(OAUTH_CLIENT_SECRET_PATTERN.findall(binary))
    client_id = _supported_binary_value(
        client_ids,
        client_id_hashes,
        "OAuth client ID",
    )
    client_secret = _supported_binary_value(
        client_secrets,
        client_secret_hashes,
        "OAuth client secret",
    )
    return client_id, client_secret


def ensure_oauth_client_config():
    """Load or securely derive the OAuth client needed for browser login."""
    global CLIENT_ID, CLIENT_SECRET
    if CLIENT_ID and CLIENT_SECRET:
        return CLIENT_ID, CLIENT_SECRET, "configured"

    client_id, client_secret = extract_antigravity_oauth_client()
    ensure_storage_migrated()
    atomic_write(
        OAUTH_CONFIG_FILE,
        json.dumps(
            {
                "client_id": client_id,
                "client_secret": client_secret,
            },
            indent=2,
        )
        + "\n",
        0o600,
    )
    CLIENT_ID = client_id
    CLIENT_SECRET = client_secret
    return CLIENT_ID, CLIENT_SECRET, "antigravity-language-server"


def oauth_client_bootstrap():
    """Prepare OAuth client configuration without printing credential data."""
    try:
        _, _, source = ensure_oauth_client_config()
    except RuntimeError as exc:
        print(json.dumps({
            "status": "unsupported",
            "ready": False,
            "message": str(exc),
        }, ensure_ascii=False))
        return 1
    print(json.dumps({
        "status": "ready",
        "ready": True,
        "source": source,
        "message": "Antigravity Web OAuth 客户端已就绪",
    }, ensure_ascii=False))
    return 0


def ensure_proxy_layout():
    ensure_storage_migrated()
    PROXY_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(PROXY_DIR, 0o700)


def ensure_proxy_key():
    ensure_proxy_layout()
    if PROXY_KEY_FILE.is_file():
        key = PROXY_KEY_FILE.read_text(encoding="utf-8").strip()
        if key:
            os.chmod(PROXY_KEY_FILE, 0o600)
            return key
    key = "agy_" + secrets.token_urlsafe(32)
    atomic_write(PROXY_KEY_FILE, key + "\n", 0o600)
    return key


def ensure_proxy_config():
    key = ensure_proxy_key()
    config = f"""host: "127.0.0.1"
port: {PROXY_PORT}
auth-dir: "{AUTH_DIR}"
api-keys:
  - {json.dumps(key)}
remote-management:
  allow-remote: false
  secret-key: ""
  disable-control-panel: true
debug: false
logging-to-file: false
usage-statistics-enabled: false
request-retry: 1
max-retry-interval: 5
routing:
  strategy: "round-robin"
  session-affinity: true
  session-affinity-ttl: "1h"
streaming:
  keepalive-seconds: 15
  bootstrap-retries: 1
"""
    atomic_write(PROXY_CONFIG_FILE, config, 0o600)
    return key


def proxy_sync_auth():
    """Reconcile account membership without overwriting CLIProxyAPI-owned tokens."""
    ensure_proxy_config()
    try:
        index_data = json.loads(ACCOUNTS_INDEX.read_text(encoding="utf-8"))
    except Exception as exc:
        print(json.dumps({"status": "error", "error": f"Failed to read accounts: {exc}"}))
        return 1

    expected = set()
    for stub in index_data.get("accounts", []):
        account_id = str(stub.get("id") or "")
        if not account_id or stub.get("disabled"):
            continue
        source = ACCOUNTS_DIR / f"{account_id}.json"
        if not source.is_file():
            continue
        try:
            account = json.loads(source.read_text(encoding="utf-8"))
        except Exception:
            continue
        if account.get("disabled"):
            continue

        safe_id = re.sub(r"[^A-Za-z0-9._-]", "_", account_id)
        target = AUTH_DIR / f"antigravity-{safe_id}.json"
        expected.add(target.name)
        if target.is_file():
            os.chmod(target, 0o600)
            continue

        legacy_proxy = LEGACY_PROXY_AUTH_DIR / target.name
        token = account.get("token") or {}
        if legacy_proxy.is_file():
            atomic_write(target, legacy_proxy.read_text(encoding="utf-8"), 0o600)
        elif token.get("refresh_token") or token.get("access_token"):
            credential = {
                "type": "antigravity",
                "email": account.get("email") or token.get("email") or "",
                "access_token": token.get("access_token") or "",
                "refresh_token": token.get("refresh_token") or "",
                "expires_in": int(token.get("expires_in") or 3599),
                "project_id": token.get("project_id") or "aicode-consumers",
                "token_type": token.get("token_type") or "Bearer",
            }
            atomic_write(target, json.dumps(credential, indent=2) + "\n", 0o600)

    for stale in AUTH_DIR.glob("antigravity-*.json"):
        if stale.name not in expected:
            stale.unlink(missing_ok=True)

    available = len(list(AUTH_DIR.glob("antigravity-*.json")))
    result = {"status": "synced", "accounts": available}
    print(json.dumps(result))
    return 0 if available else 1


def credentials_migrate():
    """Move active credentials into one CLIProxyAPI-owned auth directory."""
    if proxy_is_active():
        print(json.dumps({"status": "error", "error": "Stop the proxy before migrating credentials"}))
        return 1

    ensure_storage_migrated()
    timestamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    backup_dir = BACKUPS_DIR / f"credential-migration-{timestamp}"
    backup_dir.mkdir(parents=True, exist_ok=False, mode=0o700)
    os.chmod(BACKUPS_DIR, 0o700)
    os.chmod(backup_dir, 0o700)

    for source in [
        ACCOUNTS_INDEX,
        OAUTH_CONFIG_FILE,
        *ACCOUNTS_DIR.glob("*.json"),
        *AUTH_DIR.glob("*.json"),
        *LEGACY_PROXY_AUTH_DIR.glob("*.json"),
    ]:
        if not source.is_file():
            continue
        relative = source.relative_to(ANTIGRAVITY_DIR)
        target = backup_dir / relative
        target.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        os.chmod(target.parent, 0o700)
        shutil.copy2(source, target)
        os.chmod(target, 0o600)

    index_data = json.loads(ACCOUNTS_INDEX.read_text(encoding="utf-8"))
    migrated = 0
    for stub in index_data.get("accounts", []):
        account_id = str(stub.get("id") or "")
        if not account_id:
            continue
        safe_id = re.sub(r"[^A-Za-z0-9._-]", "_", account_id)
        credential_file = AUTH_DIR / f"antigravity-{safe_id}.json"
        legacy_proxy = LEGACY_PROXY_AUTH_DIR / credential_file.name
        account_file = ACCOUNTS_DIR / f"{account_id}.json"
        account = json.loads(account_file.read_text(encoding="utf-8")) if account_file.is_file() else {}
        token = account.get("token") or {}

        if legacy_proxy.is_file():
            credential = json.loads(legacy_proxy.read_text(encoding="utf-8"))
        elif credential_file.is_file():
            credential = json.loads(credential_file.read_text(encoding="utf-8"))
        elif token.get("refresh_token") or token.get("access_token"):
            credential = {
                "type": "antigravity",
                "email": account.get("email") or token.get("email") or stub.get("email") or "",
                "access_token": token.get("access_token") or "",
                "refresh_token": token.get("refresh_token") or "",
                "expires_in": int(token.get("expires_in") or 3599),
                "project_id": token.get("project_id") or "aicode-consumers",
                "token_type": token.get("token_type") or "Bearer",
            }
        else:
            raise RuntimeError(f"No credential found for account {account_id}")

        credential["type"] = "antigravity"
        credential["email"] = credential.get("email") or account.get("email") or stub.get("email") or ""
        credential["project_id"] = credential.get("project_id") or token.get("project_id") or "aicode-consumers"
        atomic_write(credential_file, json.dumps(credential, indent=2) + "\n", 0o600)

        account["id"] = account_id
        account["email"] = account.get("email") or stub.get("email") or credential.get("email") or ""
        account["name"] = account.get("name") or stub.get("name") or account["email"]
        account["project_id"] = credential["project_id"]
        account.pop("token", None)
        atomic_write(account_file, json.dumps(account, indent=2) + "\n", 0o600)
        migrated += 1

    for legacy_file in LEGACY_PROXY_AUTH_DIR.glob("antigravity-*.json"):
        legacy_file.unlink(missing_ok=True)

    for directory in [backup_dir, *(path for path in backup_dir.rglob("*") if path.is_dir())]:
        os.chmod(directory, 0o700)

    ensure_proxy_config()
    print(json.dumps({
        "status": "migrated",
        "accounts": migrated,
        "auth_dir": str(AUTH_DIR),
        "backup": str(backup_dir),
    }))
    return 0


def proxy_provider_config():
    key_command = f"!cat {PROXY_KEY_FILE}"
    models = []
    for model in PROXY_MODELS:
        configured = dict(model)
        configured["cost"] = {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0}
        models.append(configured)
    return {
        "baseUrl": PROXY_BASE_URL,
        "apiKey": key_command,
        "api": PROXY_CLIENT_API,
        "models": models,
    }


def proxy_configure_pi():
    PI_MODELS_FILE.parent.mkdir(parents=True, exist_ok=True)
    data = {}
    mode = 0o600
    if PI_MODELS_FILE.is_file():
        mode = PI_MODELS_FILE.stat().st_mode & 0o777
        try:
            data = json.loads(PI_MODELS_FILE.read_text(encoding="utf-8"))
        except Exception as exc:
            raise RuntimeError(f"Failed to read {PI_MODELS_FILE}: {exc}") from exc
    providers = data.setdefault("providers", {})
    providers[PROXY_PROVIDER_ID] = proxy_provider_config()
    atomic_write(PI_MODELS_FILE, json.dumps(data, indent=2) + "\n", mode)


def proxy_configure_omp():
    OMP_MODELS_FILE.parent.mkdir(parents=True, exist_ok=True)
    mode = 0o600
    text = "providers:\n"
    if OMP_MODELS_FILE.is_file():
        mode = OMP_MODELS_FILE.stat().st_mode & 0o777
        text = OMP_MODELS_FILE.read_text(encoding="utf-8")

    start = text.find(MANAGED_OMP_START)
    if start >= 0:
        end = text.find(MANAGED_OMP_END, start)
        if end >= 0:
            end += len(MANAGED_OMP_END)
            text = (text[:start].rstrip() + "\n" + text[end:].lstrip("\n")).rstrip() + "\n"

    lines = [
        MANAGED_OMP_START,
        f"  {PROXY_PROVIDER_ID}:",
        f"    baseUrl: {PROXY_BASE_URL}",
        f"    apiKey: \"!cat {PROXY_KEY_FILE}\"",
        f"    api: {PROXY_CLIENT_API}",
        "    models:",
    ]
    for model in PROXY_MODELS:
        lines.extend([
            f"      - id: {model['id']}",
            f"        name: {model['name']}",
            f"        reasoning: {'true' if model['reasoning'] else 'false'}",
            f"        input: [{', '.join(model['input'])}]",
            f"        contextWindow: {model['contextWindow']}",
            f"        maxTokens: {model['maxTokens']}",
            "        cost:",
            "          input: 0",
            "          output: 0",
            "          cacheRead: 0",
            "          cacheWrite: 0",
        ])
    lines.append(MANAGED_OMP_END)
    atomic_write(OMP_MODELS_FILE, text.rstrip() + "\n\n" + "\n".join(lines) + "\n", mode)


def proxy_configure_clients():
    ensure_proxy_config()
    proxy_configure_pi()
    proxy_configure_omp()
    print(json.dumps({
        "status": "configured",
        "clients": ["pi", "omp"],
        "provider": PROXY_PROVIDER_ID,
    }))
    return 0


def run_systemctl(*args):
    return subprocess.run(
        ["systemctl", "--user", *args],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )


def proxy_install():
    ensure_proxy_config()
    if not PROXY_BINARY.is_file():
        candidates = [
            Path(os.environ.get("CLIPROXYAPI_BINARY", "")).expanduser(),
            Path("/tmp/cliproxy_test/cli-proxy-api"),
        ]
        source = next((path for path in candidates if str(path) and path.is_file()), None)
        if source is None:
            print(json.dumps({"status": "error", "error": "CLIProxyAPI binary not found"}))
            return 1
        PROXY_BINARY.parent.mkdir(parents=True, exist_ok=True)
        fd, temp_name = tempfile.mkstemp(prefix=".cli-proxy-api.", dir=PROXY_BINARY.parent)
        os.close(fd)
        try:
            shutil.copy2(source, temp_name)
            os.chmod(temp_name, 0o755)
            os.replace(temp_name, PROXY_BINARY)
        finally:
            Path(temp_name).unlink(missing_ok=True)

    systemd_dir = Path(__file__).resolve().parent.parent / "systemd"
    unit_targets = [
        (systemd_dir / PROXY_SERVICE_NAME, PROXY_SERVICE_FILE),
        (systemd_dir / PROXY_WATCHDOG_SERVICE_NAME, PROXY_WATCHDOG_SERVICE_FILE),
        (systemd_dir / PROXY_WATCHDOG_TIMER_NAME, PROXY_WATCHDOG_TIMER_FILE),
    ]
    for source, target in unit_targets:
        if not source.is_file():
            print(json.dumps({"status": "error", "error": f"Missing service template: {source}"}))
            return 1
        atomic_write(target, source.read_text(encoding="utf-8"), 0o644)

    reload_result = run_systemctl("daemon-reload")
    if reload_result.returncode != 0:
        print(json.dumps({"status": "error", "error": reload_result.stderr.strip()}))
        return 1
    enable_result = run_systemctl("enable", PROXY_SERVICE_NAME, PROXY_WATCHDOG_TIMER_NAME)
    if enable_result.returncode != 0:
        print(json.dumps({"status": "error", "error": enable_result.stderr.strip()}))
        return 1
    run_systemctl("start", PROXY_WATCHDOG_TIMER_NAME)
    return proxy_configure_clients()


def proxy_is_active():
    return run_systemctl("is-active", "--quiet", PROXY_SERVICE_NAME).returncode == 0


def proxy_models_ready():
    try:
        request = urllib.request.Request(
            f"{PROXY_BASE_URL}/models",
            headers={"Authorization": f"Bearer {ensure_proxy_key()}"},
        )
        with urllib.request.urlopen(request, timeout=2) as response:
            if not 200 <= response.status < 300:
                return False
            payload = json.loads(response.read().decode("utf-8"))
            model_ids = {str(item.get("id") or "") for item in payload.get("data", [])}
            return all(model["id"] in model_ids for model in PROXY_MODELS)
    except Exception:
        return False


def proxy_health():
    return proxy_is_active() and proxy_models_ready()


def proxy_wait_ready():
    for _ in range(40):
        if proxy_models_ready():
            print(json.dumps({"status": "ready"}))
            return 0
        time.sleep(0.25)
    print(json.dumps({"status": "error", "error": "Proxy model catalog did not become ready"}))
    return 1


def proxy_start():
    if not PROXY_BINARY.is_file() or not PROXY_SERVICE_FILE.is_file():
        if proxy_install() != 0:
            return 1
    if proxy_sync_auth() != 0:
        return 1
    proxy_configure_pi()
    proxy_configure_omp()
    run_systemctl("enable", PROXY_SERVICE_NAME)
    result = run_systemctl("start", PROXY_SERVICE_NAME)
    if result.returncode != 0:
        print(json.dumps({"status": "error", "error": result.stderr.strip()}))
        return 1
    for _ in range(20):
        if proxy_health():
            print(json.dumps({"status": "running", "endpoint": PROXY_BASE_URL}))
            return 0
        time.sleep(0.25)
    print(json.dumps({"status": "error", "error": "Proxy started but health check failed"}))
    return 1


def proxy_stop():
    result = run_systemctl("stop", PROXY_SERVICE_NAME)
    if result.returncode != 0:
        print(json.dumps({"status": "error", "error": result.stderr.strip()}))
        return 1
    print(json.dumps({"status": "stopped"}))
    return 0


def proxy_status():
    auth_count = len(list(AUTH_DIR.glob("antigravity-*.json"))) if AUTH_DIR.is_dir() else 0
    active = proxy_is_active()
    state = {
        "status": "running" if active else "stopped",
        "installed": PROXY_BINARY.is_file() and PROXY_SERVICE_FILE.is_file(),
        "active": active,
        "healthy": proxy_health() if active else False,
        "endpoint": PROXY_BASE_URL,
        "accounts": auth_count,
        "provider": PROXY_PROVIDER_ID,
        "piCommand": f"pi --model {PROXY_PROVIDER_ID}/gemini-3.7-flash-high",
        "ompCommand": f"omp --model {PROXY_PROVIDER_ID}/gemini-3.7-flash-high",
    }
    print(json.dumps(state))
    return 0


def proxy_watchdog():
    """Restart once for new authentication failures, then notify if they persist."""
    ensure_proxy_layout()
    now_ts = int(time.time())
    state = {"last_check": now_ts - 600, "last_recovery": 0, "last_category": "", "notified": False}
    if PROXY_WATCHDOG_STATE_FILE.is_file():
        try:
            state.update(json.loads(PROXY_WATCHDOG_STATE_FILE.read_text(encoding="utf-8")))
        except Exception:
            pass

    since_ts = max(0, int(state.get("last_check") or now_ts - 600))
    logs = subprocess.run(
        [
            "journalctl", "--user", "-u", PROXY_SERVICE_NAME,
            "--since", f"@{since_ts}", "--no-pager", "-o", "cat",
        ],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    ).stdout.lower()

    categories = [
        ("auth_unavailable", ["auth_unavailable", "no auth available"]),
        ("invalid_refresh", ["invalid_grant", "invalid refresh token", "refresh token is required"]),
        ("upstream_unauthorized", ["upstream returned 401", "upstream status 401"]),
    ]
    category = next((name for name, needles in categories if any(needle in logs for needle in needles)), "")
    state["last_check"] = now_ts

    if not category:
        atomic_write(PROXY_WATCHDOG_STATE_FILE, json.dumps(state, indent=2) + "\n", 0o600)
        return 0

    last_recovery = int(state.get("last_recovery") or 0)
    if category != state.get("last_category") or (now_ts - last_recovery) >= 3600:
        result = run_systemctl("restart", PROXY_SERVICE_NAME)
        state.update({
            "last_recovery": now_ts,
            "last_category": category,
            "notified": False,
        })
        if result.returncode == 0:
            send_notification("Antigravity Proxy", "检测到认证故障，已自动重启一次")
        else:
            send_notification("Antigravity Proxy", "认证故障自动恢复失败，请检查服务")
    elif not state.get("notified"):
        send_notification("Antigravity Proxy", "认证故障仍然存在，需要重新登录账号")
        state["notified"] = True

    atomic_write(PROXY_WATCHDOG_STATE_FILE, json.dumps(state, indent=2) + "\n", 0o600)
    return 0


def proxy_copy_client(client):
    commands = {
        "pi": f"pi --model {PROXY_PROVIDER_ID}/gemini-3.7-flash-high",
        "omp": f"omp --model {PROXY_PROVIDER_ID}/gemini-3.7-flash-high",
    }
    command = commands.get(client)
    if not command:
        print(json.dumps({"status": "error", "error": "Client must be pi or omp"}))
        return 1
    if not copy_to_clipboard(command):
        print(json.dumps({"status": "error", "error": "Clipboard command failed"}))
        return 1
    print(json.dumps({"status": "copied", "client": client}))
    return 0


def copy_to_clipboard(text):
    for cmd in [["wl-copy"], ["xclip", "-selection", "clipboard"], ["xsel", "-b"]]:
        try:
            p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            p.communicate(input=text.encode("utf-8"), timeout=2)
            if p.returncode == 0:
                return True
        except Exception:
            continue
    return False


def send_notification(title, message):
    try:
        subprocess.Popen(
            ["notify-send", "-a", "Omarchy Agents", "-i", "dialog-information", title, message],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL
        )
    except Exception:
        pass


def trigger_collector_update():
    update_bin = HOME / ".config" / "omarchy" / "plugins" / "eipi10.agents" / "bin" / "omarchy-agent-usage-update"
    if update_bin.is_file():
        try:
            subprocess.Popen([str(update_bin), "antigravity"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass


def get_free_port():
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.bind(("127.0.0.1", 0))
    port = s.getsockname()[1]
    s.close()
    return port


def credential_path(account_id):
    safe_id = re.sub(r"[^A-Za-z0-9._-]", "_", str(account_id or ""))
    return AUTH_DIR / f"antigravity-{safe_id}.json"


def load_credential(account_id):
    """Read the canonical credential without refreshing or rewriting it."""
    path = credential_path(account_id)
    if not path.is_file():
        return {}
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {}


def credential_needs_refresh(credential, min_validity_seconds=300):
    """Refresh only when the access token is absent or close to expiry."""
    if not credential.get("access_token"):
        return True
    expiry = credential.get("expired")
    if expiry:
        try:
            expires_at = datetime.fromisoformat(str(expiry).replace("Z", "+00:00"))
            if expires_at.tzinfo is None:
                expires_at = expires_at.replace(tzinfo=timezone.utc)
            remaining = (expires_at - datetime.now(timezone.utc)).total_seconds()
            return remaining <= min_validity_seconds
        except (TypeError, ValueError):
            pass
    try:
        issued_at = float(credential.get("timestamp") or 0) / 1000
        expires_in = float(credential.get("expires_in") or 0)
        return issued_at + expires_in - time.time() <= min_validity_seconds
    except (TypeError, ValueError):
        return True


def current_account():
    """Return the active account stub without exposing its credential."""
    if not ACCOUNTS_INDEX.is_file():
        return {}
    try:
        index_data = json.loads(ACCOUNTS_INDEX.read_text(encoding="utf-8"))
    except Exception:
        return {}
    current_id = index_data.get("current_account_id")
    for account in index_data.get("accounts", []):
        if account.get("id") == current_id and not account.get("disabled"):
            return account
    return {}


def voice_account():
    """Return Omarvoice's pinned account without following App switches."""
    if not ACCOUNTS_INDEX.is_file():
        return {}
    try:
        index_data = json.loads(ACCOUNTS_INDEX.read_text(encoding="utf-8"))
    except Exception:
        return {}
    voice_id = index_data.get("voice_account_id")
    for account in index_data.get("accounts", []):
        if account.get("id") == voice_id and not account.get("disabled"):
            return account
    return {}


def token_scopes(access_token):
    """Resolve granted OAuth scopes without printing or persisting the token."""
    if not access_token:
        return set()
    query = urllib.parse.urlencode({"access_token": access_token})
    try:
        request = urllib.request.Request(
            f"{TOKENINFO_URL}?{query}",
            headers={"User-Agent": "Antigravity/1.0.0 (Linux)"},
        )
        with urllib.request.urlopen(request, timeout=10) as response:
            payload = json.loads(response.read().decode("utf-8"))
    except Exception:
        return set()
    return set(str(payload.get("scope") or "").split())


def access_token_email(access_token):
    """Resolve the owner of an access token; return empty only for rejection."""
    if not access_token:
        return ""
    request = urllib.request.Request(
        USERINFO_URL,
        headers={
            "Authorization": f"Bearer {access_token}",
            "User-Agent": "Antigravity/1.0.0 (Linux)",
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            payload = json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        if exc.code in (400, 401, 403):
            return ""
        raise RuntimeError(f"Could not validate Antigravity credentials: HTTP {exc.code}") from exc
    except Exception as exc:
        raise RuntimeError(f"Could not validate Antigravity credentials: {exc}") from exc
    return str(payload.get("email") or "")


def refresh_credential_data(credential):
    """Mint fresh OAuth data while preserving a rotated long-lived token."""
    credential = dict(credential or {})
    refresh_token = credential.get("refresh_token")
    if not credential:
        raise RuntimeError("Active Agent Panel account has no Antigravity credential")
    if not refresh_token:
        raise RuntimeError("Active Agent Panel account has no refresh token")
    client_id, client_secret, _ = ensure_oauth_client_config()

    token_params = urllib.parse.urlencode({
        "client_id": client_id,
        "client_secret": client_secret,
        "refresh_token": refresh_token,
        "grant_type": "refresh_token",
    }).encode("utf-8")
    request = urllib.request.Request(
        TOKEN_URL,
        data=token_params,
        headers={
            "Content-Type": "application/x-www-form-urlencoded",
            "User-Agent": "Antigravity/1.0.0 (Linux)",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=15) as response:
            token_response = json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        error_name = ""
        try:
            error_payload = json.loads(exc.read().decode("utf-8"))
            error_name = str(error_payload.get("error") or "")
        except Exception:
            pass
        if error_name == "invalid_grant":
            raise RuntimeError(
                "Antigravity 长期授权已失效，需要重新登录一次"
            ) from exc
        raise RuntimeError(
            f"Could not refresh the active Agent Panel account: HTTP {exc.code}"
        ) from exc
    except Exception as exc:
        raise RuntimeError(f"Could not refresh the active Agent Panel account: {exc}") from exc

    access_token = token_response.get("access_token")
    if not access_token:
        raise RuntimeError("OAuth refresh returned no access token")

    now_ts = int(time.time())
    expires_in = int(token_response.get("expires_in", 3599))
    expiry_ts = now_ts + expires_in
    granted_scopes = set(str(token_response.get("scope") or credential.get("scope") or "").split())
    if not granted_scopes:
        granted_scopes = token_scopes(access_token)

    credential.update({
        "access_token": access_token,
        "refresh_token": token_response.get("refresh_token") or refresh_token,
        "expires_in": expires_in,
        "token_type": token_response.get("token_type") or credential.get("token_type") or "Bearer",
        "timestamp": now_ts * 1000,
        "expired": datetime.fromtimestamp(expiry_ts, timezone.utc).isoformat(),
        "scope": " ".join(sorted(granted_scopes)),
    })
    if token_response.get("id_token"):
        credential["id_token"] = token_response["id_token"]
    return credential, granted_scopes


def save_credential(account_id, credential):
    """Atomically persist one canonical credential."""
    atomic_write(
        credential_path(account_id),
        json.dumps(credential, indent=2) + "\n",
        0o600,
    )


def refresh_credential(account_id):
    """Refresh one canonical credential and atomically preserve its long-lived token."""
    credential, granted_scopes = refresh_credential_data(load_credential(account_id))
    save_credential(account_id, credential)
    return credential, granted_scopes


def voice_auth_status():
    """Report Omarvoice readiness without returning any OAuth material."""
    ensure_storage_migrated()
    account = voice_account()
    if not account:
        print(json.dumps({
            "status": "voice_account_required",
            "ready": False,
            "message": "请先为 Omarvoice 指定一个固定账号",
        }, ensure_ascii=False))
        return 1

    credential = load_credential(account.get("id"))
    if not credential.get("refresh_token"):
        print(json.dumps({
            "status": "authorization_required",
            "ready": False,
            "email": account.get("email") or "",
            "message": "Omarvoice 固定账号缺少长期授权",
        }, ensure_ascii=False))
        return 1

    granted_scopes = set(str(credential.get("scope") or "").split())
    if AICODE_SCOPE not in granted_scopes:
        granted_scopes = token_scopes(credential.get("access_token"))
    if AICODE_SCOPE not in granted_scopes:
        print(json.dumps({
            "status": "reauthorize_required",
            "ready": False,
            "email": account.get("email") or "",
            "message": "需要重新授权一次，以启用 Omarvoice 听写权限",
        }, ensure_ascii=False))
        return 2

    print(json.dumps({
        "status": "ready",
        "ready": True,
        "email": account.get("email") or "",
        "message": "Omarvoice 固定账号已就绪",
    }, ensure_ascii=False))
    return 0


def _standalone_token_payload(credential):
    """Serialize the native token shape accepted by Antigravity standalone."""
    credential = dict(credential or {})
    if not credential.get("access_token") or not credential.get("refresh_token"):
        raise RuntimeError("Omarvoice 凭据不完整")
    expiry = credential.get("expired") or datetime.now(timezone.utc).isoformat()
    return {
        "auth_method": "consumer",
        "token": {
            "access_token": credential["access_token"],
            "expiry": expiry,
            "refresh_token": credential["refresh_token"],
            "token_type": credential.get("token_type") or "Bearer",
        },
    }


def write_omarvoice_credential(credential):
    """Atomically update Omarvoice's private file-based token store."""
    token_dir = OMARVOICE_TOKEN_FILE.parent
    token_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    enforce_mode(OMARVOICE_AUTH_HOME, 0o700)
    enforce_mode(token_dir, 0o700)
    atomic_write(
        OMARVOICE_TOKEN_FILE,
        json.dumps(
            _standalone_token_payload(credential),
            separators=(",", ":"),
        )
        + "\n",
        0o600,
    )


def read_omarvoice_credential():
    """Read Omarvoice's isolated runtime token without exposing it."""
    try:
        payload = json.loads(OMARVOICE_TOKEN_FILE.read_text(encoding="utf-8"))
    except (OSError, TypeError, json.JSONDecodeError):
        return {}
    if not isinstance(payload, dict):
        return {}
    token = payload.get("token")
    token = token if isinstance(token, dict) else payload
    if not token.get("access_token") or not token.get("refresh_token"):
        return {}

    credential = {
        "access_token": token["access_token"],
        "refresh_token": token["refresh_token"],
        "token_type": token.get("token_type") or "Bearer",
        "expired": token.get("expiry") or token.get("expired") or "",
    }
    try:
        expiry = datetime.fromisoformat(
            str(credential["expired"]).replace("Z", "+00:00")
        )
        if expiry.tzinfo is None:
            expiry = expiry.replace(tzinfo=timezone.utc)
        now_ts = int(time.time())
        credential["timestamp"] = now_ts * 1000
        credential["expires_in"] = max(0, int(expiry.timestamp()) - now_ts)
    except (TypeError, ValueError):
        pass
    return credential


def absorb_omarvoice_runtime_credential(account):
    """Preserve a token rotated by Omarvoice's isolated language server."""
    if not account:
        return False
    runtime = read_omarvoice_credential()
    if not runtime:
        return False

    credential = load_credential(account.get("id"))
    credential.update(runtime)
    granted_scopes = set(str(credential.get("scope") or "").split())
    try:
        owner_email = access_token_email(credential.get("access_token"))
        if not owner_email and credential.get("refresh_token"):
            credential, granted_scopes = refresh_credential_data(credential)
            owner_email = access_token_email(credential.get("access_token"))
    except RuntimeError:
        return False

    expected_email = str(account.get("email") or credential.get("email") or "")
    if not owner_email or (
        expected_email and owner_email.casefold() != expected_email.casefold()
    ):
        return False
    if not granted_scopes:
        granted_scopes = token_scopes(credential.get("access_token"))
    credential["email"] = expected_email or owner_email
    if granted_scopes:
        credential["scope"] = " ".join(sorted(granted_scopes))
    save_credential(account.get("id"), credential)
    return True


def sync_voice_account(account):
    """Refresh and stage one account in Omarvoice's isolated token store."""
    if not account:
        return {
            "status": "voice_account_required",
            "ready": False,
            "message": "请先为 Omarvoice 指定一个固定账号",
        }, 1

    absorb_omarvoice_runtime_credential(account)
    credential = load_credential(account.get("id"))
    granted_scopes = set(str(credential.get("scope") or "").split())
    refreshed = False
    if credential_needs_refresh(credential):
        try:
            credential, granted_scopes = refresh_credential(account.get("id"))
            refreshed = True
        except RuntimeError as exc:
            return {
                "status": "refresh_failed",
                "ready": False,
                "email": account.get("email") or "",
                "message": str(exc),
            }, 1

    if AICODE_SCOPE not in granted_scopes:
        granted_scopes = token_scopes(credential.get("access_token"))
    if AICODE_SCOPE not in granted_scopes:
        return {
            "status": "reauthorize_required",
            "ready": False,
            "email": account.get("email") or "",
            "message": "固定账号缺少 Omarvoice 听写权限，请在 Agent Panel 重新授权",
        }, 2

    try:
        write_omarvoice_credential(credential)
    except (OSError, RuntimeError) as exc:
        return {
            "status": "credential_write_failed",
            "ready": False,
            "email": account.get("email") or "",
            "message": f"{exc}，无法更新 Omarvoice 独立凭据",
        }, 1

    return {
        "status": "ready",
        "ready": True,
        "email": account.get("email") or "",
        "refreshed": refreshed,
        "message": "Omarvoice 固定账号凭据已同步",
    }, 0


def bind_voice_account(account_id):
    """Pin Omarvoice to one registered account without switching the App."""
    ensure_storage_migrated()
    try:
        index_data = json.loads(ACCOUNTS_INDEX.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        print(json.dumps({
            "status": "account_index_error",
            "ready": False,
            "message": f"无法读取账号索引：{exc}",
        }, ensure_ascii=False))
        return 1

    account = next(
        (
            item
            for item in index_data.get("accounts", [])
            if item.get("id") == account_id and not item.get("disabled")
        ),
        None,
    )
    if not account:
        print(json.dumps({
            "status": "account_not_found",
            "ready": False,
            "message": "指定的 Omarvoice 账号不存在或已停用",
        }, ensure_ascii=False))
        return 1

    result, exit_code = sync_voice_account(account)
    if exit_code:
        print(json.dumps(result, ensure_ascii=False))
        return exit_code

    index_data["voice_account_id"] = account_id
    try:
        atomic_write(
            ACCOUNTS_INDEX,
            json.dumps(index_data, indent=2) + "\n",
            0o600,
        )
    except OSError as exc:
        print(json.dumps({
            "status": "account_index_write_failed",
            "ready": False,
            "message": f"无法保存 Omarvoice 固定账号：{exc}",
        }, ensure_ascii=False))
        return 1

    result["pinned"] = True
    print(json.dumps(result, ensure_ascii=False))
    return 0


def write_keyring_credential(credential):
    """Atomically replace Antigravity's single libsecret credential."""
    if not shutil.which("secret-tool"):
        raise RuntimeError("系统安全存储不可用")
    credential = dict(credential or {})
    if not credential.get("access_token") or not credential.get("refresh_token"):
        raise RuntimeError("Antigravity 凭据不完整")

    expiry = credential.get("expired") or datetime.now(timezone.utc).isoformat()
    native_secret = json.dumps({
        "auth_method": "consumer",
        "token": {
            "access_token": credential["access_token"],
            "expiry": expiry,
            "refresh_token": credential["refresh_token"],
            "token_type": credential.get("token_type") or "Bearer",
        },
    }, separators=(",", ":"))
    try:
        stored = subprocess.run(
            [
                "secret-tool", "store",
                "--label=Password for 'antigravity' on 'gemini'",
                "service", "gemini",
                "username", "antigravity",
            ],
            input=native_secret,
            text=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=10,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise RuntimeError("系统安全存储没有响应") from exc
    if stored.returncode != 0:
        raise RuntimeError("无法写入系统安全存储")


def sync_account_to_keyring(
    account,
    force_refresh=False,
    validate_access=False,
    require_aicode=True,
):
    """Write one account to Antigravity's native store without printing secrets."""
    if not account:
        return {
            "status": "authorization_required",
            "ready": False,
            "message": "请先在 Agent Panel 授权 Antigravity 账号",
        }, 1
    if not shutil.which("secret-tool"):
        return {
            "status": "keyring_unavailable",
            "ready": False,
            "message": "系统安全存储不可用，无法切换 Antigravity 账号",
        }, 1

    credential = load_credential(account.get("id"))
    granted_scopes = set(str(credential.get("scope") or "").split())
    refreshed = False
    if force_refresh or credential_needs_refresh(credential):
        try:
            credential, granted_scopes = refresh_credential(account.get("id"))
            refreshed = True
        except RuntimeError as exc:
            return {
                "status": "refresh_failed",
                "ready": False,
                "message": str(exc),
            }, 1
    expected_email = str(account.get("email") or credential.get("email") or "")
    if validate_access:
        try:
            owner_email = access_token_email(credential.get("access_token"))
            if not owner_email and not refreshed:
                credential, granted_scopes = refresh_credential(account.get("id"))
                refreshed = True
                owner_email = access_token_email(credential.get("access_token"))
        except RuntimeError as exc:
            return {
                "status": "refresh_failed",
                "ready": False,
                "message": str(exc),
            }, 1
        if not owner_email:
            return {
                "status": "reauthorize_required",
                "ready": False,
                "email": expected_email,
                "message": "Antigravity 凭证已被 Google 拒绝，需要重新登录一次",
            }, 2
        if expected_email and owner_email.casefold() != expected_email.casefold():
            return {
                "status": "credential_identity_mismatch",
                "ready": False,
                "email": expected_email,
                "message": "系统安全存储中的账号与 Agent Panel 选择不一致",
            }, 1

    if AICODE_SCOPE not in granted_scopes:
        granted_scopes = token_scopes(credential.get("access_token"))

    # App switching is validated through Antigravity's own GetAuthStatus RPC.
    # Omarvoice still requires the additional aicode scope.
    if AICODE_SCOPE not in granted_scopes and require_aicode:
        return {
            "status": "reauthorize_required",
            "ready": False,
            "email": account.get("email") or "",
            "message": "需要重新授权一次，以启用 Omarvoice 听写权限",
        }, 2

    try:
        write_keyring_credential(credential)
    except RuntimeError as exc:
        return {
            "status": "keyring_write_failed",
            "ready": False,
            "message": f"{exc}，无法同步 Antigravity 鉴权",
        }, 1

    return {
        "status": "ready",
        "ready": True,
        "email": account.get("email") or "",
        "refreshed": refreshed,
        "message": "Agent Panel 长期鉴权已同步",
    }, 0


def read_keyring_credential():
    """Read Antigravity's runtime credential without exposing it to output."""
    if not shutil.which("secret-tool"):
        return {}
    try:
        result = subprocess.run(
            [
                "secret-tool", "lookup",
                "service", "gemini",
                "username", "antigravity",
            ],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=10,
        )
    except (OSError, subprocess.TimeoutExpired):
        return {}
    if result.returncode != 0 or not result.stdout:
        return {}
    try:
        payload = json.loads(result.stdout)
        if not isinstance(payload, dict):
            return {}
        token = payload.get("token") or {}
        if not isinstance(token, dict):
            return {}
    except (TypeError, json.JSONDecodeError):
        return {}
    if not token.get("access_token") or not token.get("refresh_token"):
        return {}

    credential = {
        "access_token": token["access_token"],
        "refresh_token": token["refresh_token"],
        "token_type": token.get("token_type") or "Bearer",
        "expired": token.get("expiry") or "",
    }
    try:
        expiry = datetime.fromisoformat(
            str(credential["expired"]).replace("Z", "+00:00")
        )
        if expiry.tzinfo is None:
            expiry = expiry.replace(tzinfo=timezone.utc)
        now_ts = int(time.time())
        credential["timestamp"] = now_ts * 1000
        credential["expires_in"] = max(0, int(expiry.timestamp()) - now_ts)
    except (TypeError, ValueError):
        pass
    return credential


def absorb_runtime_keyring(account):
    """Preserve a token Antigravity rotated while the app was running."""
    if not account:
        return False
    runtime = read_keyring_credential()
    if not runtime:
        return False

    credential = load_credential(account.get("id"))
    credential.update(runtime)
    granted_scopes = set(str(credential.get("scope") or "").split())
    try:
        owner_email = access_token_email(credential.get("access_token"))
        if not owner_email and credential.get("refresh_token"):
            credential, granted_scopes = refresh_credential_data(credential)
            owner_email = access_token_email(credential.get("access_token"))
    except RuntimeError:
        return False

    expected_email = str(account.get("email") or credential.get("email") or "")
    if not owner_email or (
        expected_email and owner_email.casefold() != expected_email.casefold()
    ):
        return False
    if not granted_scopes:
        granted_scopes = token_scopes(credential.get("access_token"))
    credential["email"] = expected_email or owner_email
    if granted_scopes:
        credential["scope"] = " ".join(sorted(granted_scopes))
    save_credential(account.get("id"), credential)
    return True


def voice_auth_sync():
    """Ensure valid auth in Omarvoice's isolated token store."""
    ensure_storage_migrated()
    result, exit_code = sync_voice_account(voice_account())
    print(json.dumps(result, ensure_ascii=False))
    return exit_code


def antigravity_main_pids(proc_root=Path("/proc"), executable=None):
    """Find only the native Electron main process, never Omarvoice's server."""
    executable = Path(executable or ANTIGRAVITY_APP)
    try:
        expected_executable = executable.resolve(strict=True)
    except OSError:
        return []

    pids = []
    try:
        process_dirs = list(Path(proc_root).iterdir())
    except OSError:
        return []

    for process_dir in process_dirs:
        if not process_dir.name.isdigit():
            continue
        pid = int(process_dir.name)
        if pid == os.getpid():
            continue
        try:
            process_executable = (process_dir / "exe").resolve(strict=True)
            if process_executable != expected_executable:
                continue
            arguments = (process_dir / "cmdline").read_bytes().split(b"\0")
        except OSError:
            continue
        if any(argument.startswith(b"--type=") for argument in arguments):
            continue
        pids.append(pid)
    return sorted(pids)


def wait_for_antigravity_state(running, timeout_seconds):
    """Wait until Antigravity's main-process state matches the requested state."""
    deadline = time.monotonic() + timeout_seconds
    while time.monotonic() < deadline:
        if bool(antigravity_main_pids()) == running:
            return True
        time.sleep(0.1)
    return bool(antigravity_main_pids()) == running


def stop_antigravity_app(timeout_seconds=12):
    """Stop Antigravity before touching shared credential stores."""
    if not ANTIGRAVITY_APP.is_file():
        raise RuntimeError(f"Antigravity executable not found: {ANTIGRAVITY_APP}")

    running_pids = antigravity_main_pids()
    was_running = bool(running_pids)
    for pid in running_pids:
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass

    if was_running and not wait_for_antigravity_state(False, timeout_seconds * 0.75):
        for pid in antigravity_main_pids():
            try:
                os.kill(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
        if not wait_for_antigravity_state(False, timeout_seconds * 0.25):
            raise RuntimeError("Antigravity did not exit before restart")
    return was_running


def start_antigravity_app(timeout_seconds=12):
    """Start Antigravity detached and wait for its main process."""
    try:
        subprocess.Popen(
            [str(ANTIGRAVITY_APP)],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError as exc:
        raise RuntimeError(f"Could not launch Antigravity: {exc}") from exc
    if not wait_for_antigravity_state(True, timeout_seconds):
        raise RuntimeError("Antigravity did not start after account switch")
    return True


def restart_antigravity_app(timeout_seconds=12):
    """Gracefully replace Antigravity so it reads the selected keyring item."""
    was_running = stop_antigravity_app(timeout_seconds)
    start_antigravity_app(timeout_seconds)
    return {
        "was_running": was_running,
        "started": True,
    }


def _process_parent_pid(process_dir):
    """Read PPid from one proc status file without trusting process names."""
    try:
        for line in (process_dir / "status").read_text(encoding="utf-8").splitlines():
            if line.startswith("PPid:"):
                return int(line.split(":", 1)[1].strip())
    except (OSError, ValueError):
        pass
    return 0


def _process_arguments(process_dir):
    try:
        return [
            item.decode("utf-8", errors="replace")
            for item in (process_dir / "cmdline").read_bytes().split(b"\0")
            if item
        ]
    except OSError:
        return []


def antigravity_language_server_pids(
    proc_root=Path("/proc"),
    executable=None,
):
    """Find only the language server owned by the native Antigravity app."""
    executable = Path(executable or ANTIGRAVITY_LANGUAGE_SERVER)
    try:
        expected_executable = executable.resolve(strict=True)
    except OSError:
        return []

    app_pids = set(antigravity_main_pids(proc_root))
    if not app_pids:
        return []

    try:
        process_dirs = list(Path(proc_root).iterdir())
    except OSError:
        return []

    pids = []
    for process_dir in process_dirs:
        if not process_dir.name.isdigit():
            continue
        try:
            process_executable = (process_dir / "exe").resolve(strict=True)
        except OSError:
            continue
        if process_executable != expected_executable:
            continue
        if _process_parent_pid(process_dir) not in app_pids:
            continue

        arguments = _process_arguments(process_dir)
        app_data_dir = ""
        for index, argument in enumerate(arguments):
            if argument == "--app_data_dir" and index + 1 < len(arguments):
                app_data_dir = arguments[index + 1]
                break
            if argument.startswith("--app_data_dir="):
                app_data_dir = argument.split("=", 1)[1]
                break
        if app_data_dir != "antigravity":
            continue
        pids.append(int(process_dir.name))
    return sorted(pids)


def process_listening_ports(pid, proc_root=Path("/proc")):
    """Return TCP listening ports whose socket descriptors belong to a process."""
    process_dir = Path(proc_root) / str(pid)
    socket_inodes = set()
    try:
        descriptors = list((process_dir / "fd").iterdir())
    except OSError:
        return []

    for descriptor in descriptors:
        try:
            target = os.readlink(descriptor)
        except OSError:
            continue
        match = re.fullmatch(r"socket:\[(\d+)\]", target)
        if match:
            socket_inodes.add(match.group(1))

    ports = set()
    for table_name in ("tcp", "tcp6"):
        try:
            lines = (process_dir / "net" / table_name).read_text(
                encoding="ascii"
            ).splitlines()[1:]
        except OSError:
            continue
        for line in lines:
            columns = line.split()
            if len(columns) < 10 or columns[3] != "0A":
                continue
            if columns[9] not in socket_inodes:
                continue
            try:
                ports.add(int(columns[1].rsplit(":", 1)[1], 16))
            except (IndexError, ValueError):
                continue
    return sorted(ports)


def _local_https_request(url, data=None, headers=None, timeout=2):
    """Call Antigravity's loopback-only, self-signed HTTPS server."""
    if not url.startswith("https://127.0.0.1:"):
        raise RuntimeError("Refusing non-loopback Antigravity RPC endpoint")
    request = urllib.request.Request(
        url,
        data=data,
        headers=headers or {},
        method="POST" if data is not None else "GET",
    )
    context = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
    context.check_hostname = False
    context.verify_mode = ssl.CERT_NONE
    with urllib.request.urlopen(
        request,
        context=context,
        timeout=timeout,
    ) as response:
        return response.read()


def discover_antigravity_runtime(timeout_seconds=12):
    """Discover the App-owned language server, HTTPS port, and CSRF token."""
    deadline = time.monotonic() + timeout_seconds
    token_pattern = re.compile(rb'"csrfToken"\s*:\s*"([^"]+)"')
    last_error = "Antigravity language server is not ready"

    while time.monotonic() < deadline:
        for pid in antigravity_language_server_pids():
            for port in process_listening_ports(pid):
                try:
                    body = _local_https_request(
                        f"https://127.0.0.1:{port}/",
                        timeout=0.75,
                    )
                except Exception as exc:
                    last_error = str(exc)
                    continue
                match = token_pattern.search(body)
                if not match or b"window.__APP_CONFIG__" not in body:
                    continue
                return {
                    "pid": pid,
                    "port": port,
                    "csrf_token": match.group(1).decode("utf-8"),
                }
        time.sleep(0.15)
    raise RuntimeError(last_error)


def antigravity_rpc(runtime, method, timeout=4):
    """Call one JSON ConnectRPC method exposed by the App language server."""
    url = (
        f"https://127.0.0.1:{runtime['port']}/"
        f"{ANTIGRAVITY_RPC_SERVICE}/{method}"
    )
    body = _local_https_request(
        url,
        data=b"{}",
        headers={
            "Content-Type": "application/json",
            "Connect-Protocol-Version": "1",
            "x-codeium-csrf-token": runtime["csrf_token"],
        },
        timeout=timeout,
    )
    try:
        result = json.loads(body.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise RuntimeError(f"Antigravity {method} returned invalid JSON") from exc
    if not isinstance(result, dict):
        raise RuntimeError(f"Antigravity {method} returned an invalid response")
    return result


def _auth_failure(result):
    """Translate GetAuthStatus's protobuf oneof into stable panel metadata."""
    cases = {
        "ineligible": "account_ineligible",
        "verificationRequired": "verification_required",
        "tosViolation": "terms_violation",
        "projectRequired": "project_required",
        "licenseRequired": "license_required",
        "generalError": "authentication_failed",
    }
    for field, status in cases.items():
        if field not in result:
            continue
        details = result.get(field)
        details = details if isinstance(details, dict) else {}
        return {
            "status": status,
            "verification_url": (
                details.get("verificationUrl")
                or details.get("appealUrl")
                or ""
            ),
        }
    return {"status": "authentication_failed", "verification_url": ""}


def wait_for_antigravity_auth(expected_email="", timeout_seconds=15):
    """Use the exact startup RPC chain that controls the App's signed-in UI."""
    deadline = time.monotonic() + timeout_seconds
    last_error = "Antigravity 登录状态检查超时"

    while time.monotonic() < deadline:
        remaining = max(0.25, deadline - time.monotonic())
        try:
            runtime = discover_antigravity_runtime(min(remaining, 2))
            token_state = antigravity_rpc(runtime, "HasAuthToken")
            if not token_state.get("hasToken"):
                last_error = "Antigravity 没有读取到系统安全存储中的凭据"
                time.sleep(0.2)
                continue

            status_state = antigravity_rpc(runtime, "GetAuthStatus")
            auth_result = status_state.get("authResult") or {}
            if not isinstance(auth_result, dict):
                auth_result = {}
            # hasValidAuth is an empty protobuf message encoded as {}, so
            # field presence—not Python truthiness—is the success signal.
            if "hasValidAuth" not in auth_result:
                failure = _auth_failure(auth_result)
                message = (
                    auth_result.get("uiMessage")
                    or "Antigravity 拒绝了这个账号"
                )
                # The language server can briefly surface a generalError while
                # loadCodeAssist is still starting. Eligibility and policy
                # failures are final; transport/auth bootstrap errors are not.
                if failure["status"] == "authentication_failed":
                    last_error = message
                    time.sleep(0.2)
                    continue
                failure.update({
                    "ready": False,
                    "message": message,
                })
                return failure

            user_state = antigravity_rpc(runtime, "GetUserStatus")
            user_status = user_state.get("userStatus") or {}
            actual_email = str(user_status.get("email") or "")
            if expected_email and not actual_email:
                last_error = "Antigravity 尚未返回当前账号身份"
                time.sleep(0.2)
                continue
            if (
                expected_email
                and actual_email
                and actual_email.casefold() != expected_email.casefold()
            ):
                return {
                    "ready": False,
                    "status": "credential_identity_mismatch",
                    "email": actual_email,
                    "message": "Antigravity 启动后的账号与 Panel 选择不一致",
                }
            return {
                "ready": True,
                "status": "ready",
                "email": actual_email or expected_email,
                "message": "Antigravity 已确认登录",
            }
        except Exception as exc:
            last_error = str(exc)
            time.sleep(0.2)

    return {
        "ready": False,
        "status": "app_auth_unavailable",
        "message": last_error,
    }


def app_auth_status():
    """Print the native App's real frontend authentication decision."""
    if not antigravity_main_pids():
        print(json.dumps({
            "ready": False,
            "status": "app_stopped",
            "message": "Antigravity 未运行",
        }, ensure_ascii=False))
        return 1
    account = current_account() or {}
    result = wait_for_antigravity_auth(
        str(account.get("email") or ""),
        timeout_seconds=3,
    )
    print(json.dumps(result, ensure_ascii=False))
    return 0 if result.get("ready") else 1


def fetch_account_quotas(acc_data, account_file=None):
    """Fetch live quotas from Google Cloud Code API for an account and update account JSON."""
    credential = load_credential(acc_data.get("id"))
    access_token = credential.get("access_token")
    if not access_token:
        return False

    project_id = credential.get("project_id") or acc_data.get("project_id") or "aicode-consumers"
    headers = {
        "Authorization": f"Bearer {access_token}",
        "Content-Type": "application/json",
        "User-Agent": "Antigravity/1.0.0 (Linux)",
    }
    payload = json.dumps({"project": project_id}).encode("utf-8")

    summary_res = None
    models_res = None

    for base_url in QUOTA_ENDPOINTS:
        if not summary_res:
            try:
                req = urllib.request.Request(f"{base_url}/v1internal:retrieveUserQuotaSummary", data=payload, headers=headers, method="POST")
                with urllib.request.urlopen(req, timeout=10) as resp:
                    summary_res = json.loads(resp.read().decode("utf-8"))
            except Exception:
                pass

        if not models_res:
            try:
                req = urllib.request.Request(f"{base_url}/v1internal:fetchAvailableModels", data=payload, headers=headers, method="POST")
                with urllib.request.urlopen(req, timeout=10) as resp:
                    models_res = json.loads(resp.read().decode("utf-8"))
            except Exception:
                pass

        if summary_res and models_res:
            break

    if not summary_res and not models_res:
        return False

    now_ts = int(time.time())
    quota = acc_data.get("quota") or {}
    quota["last_updated"] = now_ts

    # 1. Update quota_groups from summary_res
    if summary_res and "groups" in summary_res:
        quota_groups = []
        for g in summary_res.get("groups", []):
            buckets = []
            for b in g.get("buckets", []):
                rem_frac = b.get("remainingFraction")
                buckets.append({
                    "bucket_id": b.get("bucketId", ""),
                    "window": b.get("window", ""),
                    "remaining_fraction": float(rem_frac) if rem_frac is not None else 1.0,
                    "reset_time": b.get("resetTime", ""),
                    "display_name": b.get("displayName", ""),
                    "description": b.get("description", "")
                })
            quota_groups.append({
                "display_name": g.get("displayName", ""),
                "description": g.get("description", ""),
                "buckets": buckets
            })
        quota["quota_groups"] = quota_groups

    # 2. Update models from models_res
    if models_res and "models" in models_res:
        model_list = []
        for m_id, m_info in models_res.get("models", {}).items():
            q_info = m_info.get("quotaInfo") or {}
            rem_frac = q_info.get("remainingFraction")
            pct = round(float(rem_frac) * 100) if rem_frac is not None else 100
            model_list.append({
                "name": m_id,
                "percentage": pct,
                "reset_time": q_info.get("resetTime", ""),
                "display_name": m_info.get("displayName", m_id),
                "supports_images": bool(m_info.get("supportsImages")),
                "supports_thinking": bool(m_info.get("supportsThinking")),
                "thinking_budget": m_info.get("thinkingBudget", 0),
                "recommended": bool(m_info.get("recommended")),
                "max_tokens": m_info.get("maxTokens", 1048576),
                "max_output_tokens": m_info.get("maxOutputTokens", 65536),
                "supported_mime_types": m_info.get("supportedMimeTypes", {})
            })
        quota["models"] = model_list

    if not quota.get("subscription_tier"):
        quota["subscription_tier"] = "Google AI Pro"

    acc_data["quota"] = quota

    if account_file and Path(account_file).is_file():
        try:
            atomic_write(account_file, json.dumps(acc_data, indent=2) + "\n", 0o600)
        except Exception:
            pass

    return True


def refresh_all_accounts(force=False):
    """Refresh cloud quotas for all active accounts."""
    ensure_storage_migrated()
    if not ACCOUNTS_INDEX.is_file():
        return False

    try:
        index_data = json.loads(ACCOUNTS_INDEX.read_text(encoding="utf-8"))
    except Exception:
        return False

    accounts = index_data.get("accounts", [])
    current_id = index_data.get("current_account_id")
    now_ts = int(time.time())
    updated_any = False

    # Prioritize current account first
    sorted_accounts = sorted(accounts, key=lambda a: 0 if a.get("id") == current_id else 1)

    for stub in sorted_accounts:
        acc_id = stub.get("id")
        if not acc_id or stub.get("disabled"):
            continue
        acc_file = ACCOUNTS_DIR / f"{acc_id}.json"
        if not acc_file.is_file():
            continue
        try:
            acc_data = json.loads(acc_file.read_text(encoding="utf-8"))
        except Exception:
            continue

        quota = acc_data.get("quota") or {}
        last_updated = int(quota.get("last_updated") or 0)

        # Refresh if forced or older than 60 seconds
        if force or (now_ts - last_updated > 60):
            if fetch_account_quotas(acc_data, acc_file):
                updated_any = True

    return updated_any


def restore_previous_app_session(
    previous_account,
    previous_credential,
    app_was_running,
):
    """Roll back both the keyring and App lifecycle after a failed switch."""
    try:
        stop_antigravity_app()
    except RuntimeError:
        pass

    auth_restored = False
    try:
        if previous_credential:
            write_keyring_credential(previous_credential)
            auth_restored = True
        elif previous_account:
            _, exit_code = sync_account_to_keyring(
                previous_account,
                validate_access=True,
                require_aicode=False,
            )
            auth_restored = exit_code == 0
    except RuntimeError:
        auth_restored = False

    app_restored = not app_was_running
    if app_was_running:
        try:
            start_antigravity_app()
            app_restored = True
        except RuntimeError:
            app_restored = False
    return {
        "auth_restored": auth_restored,
        "app_restored": app_restored,
    }


def switch_account(target_account_id):
    """Switch the native App account and commit only after its UI accepts it."""
    ensure_storage_migrated()
    if not ACCOUNTS_INDEX.is_file():
        print(json.dumps({"success": False, "error": "accounts.json not found"}))
        return 1

    try:
        data = json.loads(ACCOUNTS_INDEX.read_text(encoding="utf-8"))
    except Exception as exc:
        print(json.dumps({
            "success": False,
            "error": f"Failed to read accounts.json: {exc}",
        }))
        return 1

    accounts = data.get("accounts", [])
    previous_id = str(data.get("current_account_id") or "")
    target_account = next(
        (account for account in accounts if account.get("id") == target_account_id),
        None,
    )
    if not target_account:
        print(json.dumps({
            "success": False,
            "error": f"Account ID {target_account_id} not found",
        }))
        return 1
    if target_account.get("disabled"):
        print(json.dumps({
            "success": False,
            "error": "The selected account is disabled",
        }))
        return 1

    previous_account = next(
        (account for account in accounts if account.get("id") == previous_id),
        None,
    )
    try:
        app_was_running = stop_antigravity_app()
    except RuntimeError as exc:
        print(json.dumps({
            "success": False,
            "status": "app_stop_failed",
            "error": str(exc),
        }, ensure_ascii=False))
        return 1

    # Capture the final App-owned token before replacing the one libsecret item.
    previous_credential = read_keyring_credential()
    runtime_absorbed = bool(
        previous_account
        and previous_id != target_account_id
        and previous_credential
        and absorb_runtime_keyring(previous_account)
    )

    sync_result, sync_exit_code = sync_account_to_keyring(
        target_account,
        validate_access=True,
        require_aicode=False,
    )
    if sync_exit_code != 0:
        rollback = restore_previous_app_session(
            previous_account,
            previous_credential,
            app_was_running,
        )
        print(json.dumps({
            "success": False,
            "status": sync_result.get("status") or "keyring_sync_failed",
            "error": (
                sync_result.get("message")
                or "Failed to sync Antigravity credentials"
            ),
            **rollback,
        }, ensure_ascii=False))
        return sync_exit_code

    try:
        start_antigravity_app()
    except RuntimeError as exc:
        rollback = restore_previous_app_session(
            previous_account,
            previous_credential,
            app_was_running,
        )
        print(json.dumps({
            "success": False,
            "status": "app_start_failed",
            "error": str(exc),
            **rollback,
        }, ensure_ascii=False))
        return 1

    expected_email = str(target_account.get("email") or "")
    app_auth = wait_for_antigravity_auth(expected_email)
    if not app_auth.get("ready"):
        rollback = restore_previous_app_session(
            previous_account,
            previous_credential,
            app_was_running,
        )
        result = {
            "success": False,
            "status": app_auth.get("status") or "app_auth_failed",
            "error": app_auth.get("message") or "Antigravity 拒绝了这个账号",
            "email": expected_email,
            **rollback,
        }
        if app_auth.get("verification_url"):
            result["verification_url"] = app_auth["verification_url"]
        print(json.dumps(result, ensure_ascii=False))
        return 2

    now_ts = int(time.time())
    target_account["last_used"] = now_ts
    data["current_account_id"] = target_account_id
    try:
        atomic_write(
            ACCOUNTS_INDEX,
            json.dumps(data, indent=2) + "\n",
            0o600,
        )
    except OSError as exc:
        rollback = restore_previous_app_session(
            previous_account,
            previous_credential,
            app_was_running,
        )
        print(json.dumps({
            "success": False,
            "status": "account_index_write_failed",
            "error": f"Failed to update accounts.json: {exc}",
            **rollback,
        }, ensure_ascii=False))
        return 1

    # Preserve a refresh-token rotation performed during App startup.
    target_credential_absorbed = absorb_runtime_keyring(target_account)

    target_file = ACCOUNTS_DIR / f"{target_account_id}.json"
    if target_file.is_file():
        try:
            target_data = json.loads(target_file.read_text(encoding="utf-8"))
            target_data["last_used"] = now_ts
            fetch_account_quotas(target_data, target_file)
        except Exception:
            pass

    trigger_collector_update()
    print(json.dumps({
        "success": True,
        "status": "ready",
        "current_account_id": target_account_id,
        "email": app_auth.get("email") or expected_email,
        "keyring_synced": True,
        "frontend_verified": True,
        "app_restarted": True,
        "app_was_running": app_was_running,
        "runtime_credential_absorbed": runtime_absorbed,
        "target_credential_absorbed": target_credential_absorbed,
    }, ensure_ascii=False))
    return 0


def oauth_cancel(silent=False):
    if PID_FILE.is_file():
        try:
            pid = int(PID_FILE.read_text().strip())
            os.kill(pid, signal.SIGTERM)
        except Exception:
            pass
        finally:
            try:
                PID_FILE.unlink(missing_ok=True)
            except Exception:
                pass
    if not silent:
        print(json.dumps({"status": "cancelled"}))
    return 0


def open_oauth_browser(auth_url):
    """Open the authorization URL without tying the browser to this process."""
    omarchy = shutil.which("omarchy")
    opener = [omarchy, "launch", "browser", auth_url] if omarchy else None
    if not opener:
        xdg_open = shutil.which("xdg-open")
        opener = [xdg_open, auth_url] if xdg_open else None
    if not opener:
        return False
    try:
        subprocess.Popen(
            opener,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        return True
    except OSError:
        return False


def oauth_start():
    ensure_storage_migrated()
    try:
        client_id, client_secret, _ = ensure_oauth_client_config()
    except RuntimeError as exc:
        print(json.dumps({
            "status": "unsupported",
            "ready": False,
            "message": str(exc),
        }, ensure_ascii=False))
        return 1
    oauth_cancel(silent=True)
    PID_FILE.write_text(str(os.getpid()))

    port = get_free_port()
    state_str = str(uuid.uuid4())
    redirect_uri = f"http://localhost:{port}/oauth-callback"

    params = {
        "client_id": client_id,
        "redirect_uri": redirect_uri,
        "response_type": "code",
        "scope": SCOPES,
        "access_type": "offline",
        "prompt": "consent",
        "include_granted_scopes": "true",
        "state": state_str,
    }
    auth_url = f"{AUTH_BASE_URL}?{urllib.parse.urlencode(params)}"

    copy_to_clipboard(auth_url)
    browser_opened = open_oauth_browser(auth_url)
    if browser_opened:
        auth_message = "授权页面已打开，请在浏览器中完成登录"
    else:
        auth_message = "授权链接已复制到剪贴板，请在浏览器中打开完成登录"
    send_notification("Antigravity OAuth", auth_message)

    sys.stdout.write(json.dumps({
        "status": "listening",
        "auth_url": auth_url,
        "port": port,
        "state": state_str,
        "browser_opened": browser_opened,
    }) + "\n")
    sys.stdout.flush()

    auth_result = {"done": False, "code": None, "error": None}

    class CallbackHandler(http.server.BaseHTTPRequestHandler):
        def log_message(self, format, *args):
            pass

        def do_GET(self):
            parsed = urllib.parse.urlparse(self.path)
            if parsed.path == "/oauth-callback":
                qs = urllib.parse.parse_qs(parsed.query)
                received_code = qs.get("code", [None])[0]
                received_state = qs.get("state", [None])[0]

                if not received_code or received_state != state_str:
                    self.send_response(400)
                    self.send_header("Content-Type", "text/html; charset=utf-8")
                    self.end_headers()
                    self.wfile.write("<h1>❌ 授权失败：State 校验不匹配</h1>".encode("utf-8"))
                    auth_result["error"] = "State mismatch"
                    auth_result["done"] = True
                    return

                auth_result["code"] = received_code
                auth_result["done"] = True

                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.end_headers()
                html = """<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><title>授权已接收</title></head>
<body style="font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;text-align:center;padding:60px;background:#181825;color:#cdd6f4;">
  <div style="max-width:480px;margin:0 auto;background:#1e1e2e;padding:32px;border-radius:12px;border:1px solid #313244;">
    <h1 style="color:#a6e3a1;margin-bottom:12px;">✅ 授权已接收</h1>
    <p style="color:#a6adc8;font-size:15px;line-height:1.5;">正在返回 Agent Panel，由 Antigravity App 完成最终登录验证。<br>你可以安全关闭此标签页。</p>
  </div>
  <script>setTimeout(function(){ window.close(); }, 3000);</script>
</body>
</html>"""
                self.wfile.write(html.encode("utf-8"))
            else:
                self.send_response(404)
                self.end_headers()

    server = socketserver.TCPServer(("127.0.0.1", port), CallbackHandler)
    server.timeout = 1.0
    deadline = time.time() + 300

    while not auth_result["done"] and time.time() < deadline:
        server.handle_request()

    server.server_close()
    PID_FILE.unlink(missing_ok=True)

    if not auth_result["code"]:
        sys.stdout.write(json.dumps({"status": "error", "error": auth_result["error"] or "Timeout"}) + "\n")
        sys.stdout.flush()
        return 1

    code = auth_result["code"]
    token_params = urllib.parse.urlencode({
        "client_id": client_id,
        "client_secret": client_secret,
        "code": code,
        "redirect_uri": redirect_uri,
        "grant_type": "authorization_code",
    }).encode("utf-8")

    try:
        t_req = urllib.request.Request(
            TOKEN_URL,
            data=token_params,
            headers={
                "Content-Type": "application/x-www-form-urlencoded",
                "User-Agent": "Antigravity/1.0.0 (Linux)"
            },
            method="POST"
        )
        with urllib.request.urlopen(t_req, timeout=15) as resp:
            token_res = json.loads(resp.read().decode("utf-8"))
    except Exception as exc:
        sys.stdout.write(json.dumps({"status": "error", "error": f"Token exchange failed: {exc}"}) + "\n")
        sys.stdout.flush()
        return 1

    access_token = token_res.get("access_token")
    refresh_token = token_res.get("refresh_token")
    expires_in = int(token_res.get("expires_in", 3599))
    expiry_ts = int(time.time()) + expires_in

    user_email = ""
    user_name = ""
    try:
        u_req = urllib.request.Request(
            USERINFO_URL,
            headers={"Authorization": f"Bearer {access_token}", "User-Agent": "Antigravity/1.0.0 (Linux)"}
        )
        with urllib.request.urlopen(u_req, timeout=15) as resp:
            u_info = json.loads(resp.read().decode("utf-8"))
            user_email = u_info.get("email", "")
            user_name = u_info.get("name") or u_info.get("given_name") or user_email
    except Exception:
        user_email = f"user_{uuid.uuid4().hex[:8]}@gmail.com"
        user_name = user_email

    index_data = {"version": "2.0", "accounts": [], "current_account_id": "", "current_target_ide": "agy"}
    if ACCOUNTS_INDEX.is_file():
        try:
            index_data = json.loads(ACCOUNTS_INDEX.read_text(encoding="utf-8"))
        except Exception:
            pass

    account_id = None
    for acc in index_data.get("accounts", []):
        if acc.get("email") == user_email:
            account_id = acc.get("id")
            break

    if not account_id:
        account_id = str(uuid.uuid4())

    account_file = ACCOUNTS_DIR / f"{account_id}.json"
    auth_file = credential_path(account_id)
    now_ts = int(time.time())
    existing_account = {}
    existing_credential = {}
    if account_file.is_file():
        try:
            existing_account = json.loads(account_file.read_text(encoding="utf-8"))
        except Exception:
            pass
    if auth_file.is_file():
        try:
            existing_credential = json.loads(auth_file.read_text(encoding="utf-8"))
        except Exception:
            pass

    credential = {
        "type": "antigravity",
        "email": user_email,
        "access_token": access_token,
        "refresh_token": refresh_token or existing_credential.get("refresh_token") or "",
        "expires_in": expires_in,
        "project_id": existing_credential.get("project_id") or existing_account.get("project_id") or "aicode-consumers",
        "token_type": "Bearer",
        "scope": token_res.get("scope") or " ".join(sorted(token_scopes(access_token))),
        "id_token": token_res.get("id_token") or existing_credential.get("id_token"),
        "timestamp": now_ts * 1000,
        "expired": datetime.fromtimestamp(expiry_ts, timezone.utc).isoformat(),
        "disabled": False,
    }
    atomic_write(auth_file, json.dumps(credential, indent=2) + "\n", 0o600)

    account_obj = {
        "id": account_id,
        "email": user_email,
        "name": user_name,
        "project_id": credential["project_id"],
        "quota": existing_account.get("quota") or {
            "models": [],
            "last_updated": 0,
            "subscription_tier": "Google AI Pro"
        },
        "disabled": False,
        "created_at": int(existing_account.get("created_at") or now_ts),
        "last_used": now_ts
    }

    # Fetch initial quotas
    fetch_account_quotas(account_obj, account_file)
    atomic_write(account_file, json.dumps(account_obj, indent=2) + "\n", 0o600)

    acc_list = index_data.get("accounts", [])
    found = False
    for item in acc_list:
        if item.get("id") == account_id:
            found = True
            item["email"] = user_email
            item["name"] = user_name
            item["last_used"] = now_ts
            break

    if not found:
        acc_list.append({
            "id": account_id,
            "email": user_email,
            "name": user_name,
            "disabled": False,
            "created_at": now_ts,
            "last_used": now_ts
        })

    index_data["accounts"] = acc_list
    if not index_data.get("voice_account_id"):
        index_data["voice_account_id"] = account_id
    atomic_write(ACCOUNTS_INDEX, json.dumps(index_data, indent=2) + "\n", 0o600)

    activation_exit = switch_account(account_id)
    if activation_exit != 0:
        send_notification(
            "Antigravity OAuth",
            f"账号 {user_email} 授权成功，但自动激活失败",
        )
        sys.stdout.write(json.dumps({
            "status": "error",
            "error": "授权成功，但 Antigravity 自动激活失败",
        }, ensure_ascii=False) + "\n")
        sys.stdout.flush()
        return activation_exit

    send_notification("Antigravity OAuth", f"账号 {user_email} 授权成功！已激活")

    sys.stdout.write(json.dumps({
        "status": "success",
        "id": account_id,
        "email": user_email,
        "name": user_name
    }) + "\n")
    sys.stdout.flush()
    return 0


def main():
    ensure_storage_migrated()
    if len(sys.argv) < 2:
        print(
            "Usage: omarchy-antigravity-ctl "
            "[switch <id> | oauth-client-bootstrap | oauth-start | oauth-cancel | refresh [id] | "
            "app-auth-status | voice-bind <id> | voice-auth-status | voice-auth-sync]"
        )
        return 1

    cmd = sys.argv[1]
    if cmd == "switch":
        if len(sys.argv) < 3:
            print(json.dumps({"success": False, "error": "Missing account_id"}))
            return 1
        return switch_account(sys.argv[2])
    elif cmd == "app-auth-status":
        return app_auth_status()
    elif cmd == "oauth-client-bootstrap":
        return oauth_client_bootstrap()
    elif cmd == "oauth-start":
        return oauth_start()
    elif cmd == "oauth-cancel":
        return oauth_cancel()
    elif cmd == "refresh":
        target_id = sys.argv[2] if len(sys.argv) > 2 else None
        if target_id:
            target_file = ACCOUNTS_DIR / f"{target_id}.json"
            if target_file.is_file():
                try:
                    data = json.loads(target_file.read_text(encoding="utf-8"))
                    fetch_account_quotas(data, target_file)
                except Exception:
                    pass
        else:
            refresh_all_accounts(force=True)
        trigger_collector_update()
        print(json.dumps({"status": "refreshed"}))
        return 0
    elif cmd == "voice-auth-status":
        return voice_auth_status()
    elif cmd == "voice-auth-sync":
        return voice_auth_sync()
    elif cmd == "voice-bind":
        if len(sys.argv) < 3:
            print(json.dumps({
                "status": "account_id_required",
                "ready": False,
                "message": "缺少 Omarvoice 账号 ID",
            }, ensure_ascii=False))
            return 1
        return bind_voice_account(sys.argv[2])
    else:
        print(f"Unknown command: {cmd}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
