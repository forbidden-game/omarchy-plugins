#!/usr/bin/env python3
"""Safe Hyprland touchpad settings bridge for the Omarchy panel.

The QML panel owns interaction state. This helper owns the system boundary:
reading effective values, applying an ephemeral preview, and maintaining one
clearly marked block at the end of the user's input.lua.
"""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
from typing import Any


MANAGED_START = "-- BEGIN eipi10.touchpad (managed by the Touchpad plugin)"
MANAGED_END = "-- END eipi10.touchpad"

OPTION_SPECS = {
    "disableWhileTyping": ("input.touchpad.disable_while_typing", "bool", True),
    "naturalScroll": ("input.touchpad.natural_scroll", "bool", False),
    "scrollFactor": ("input.touchpad.scroll_factor", "float", 0.4),
    "clickfingerBehavior": ("input.touchpad.clickfinger_behavior", "bool", True),
    "tapToClick": ("input.touchpad.tap_to_click", "bool", True),
    "tapAndDrag": ("input.touchpad.tap_and_drag", "bool", True),
    "dragLock": ("input.touchpad.drag_lock", "int", 0),
}

PRESETS = {
    "typing": {
        "disableWhileTyping": True,
        "naturalScroll": False,
        "scrollFactor": 0.4,
        "clickfingerBehavior": True,
        "tapToClick": False,
        "tapAndDrag": False,
        "dragLock": 0,
        "sensitivity": -0.1,
    },
    "balanced": {
        "disableWhileTyping": True,
        "naturalScroll": False,
        "scrollFactor": 0.65,
        "clickfingerBehavior": True,
        "tapToClick": True,
        "tapAndDrag": True,
        "dragLock": 1,
        "sensitivity": 0.0,
    },
    "gesture": {
        "disableWhileTyping": True,
        "naturalScroll": True,
        "scrollFactor": 0.85,
        "clickfingerBehavior": True,
        "tapToClick": True,
        "tapAndDrag": True,
        "dragLock": 1,
        "sensitivity": 0.1,
    },
}


class TouchpadError(RuntimeError):
    """A user-facing control error."""


def input_path() -> Path:
    override = os.environ.get("OMARCHY_TOUCHPAD_INPUT_FILE")
    if override:
        return Path(override).expanduser()
    return Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "hypr" / "input.lua"


def hyprctl_path() -> str:
    return os.environ.get("HYPRCTL", "hyprctl")


def run_hypr(*args: str) -> str:
    try:
        completed = subprocess.run(
            [hyprctl_path(), *args],
            check=False,
            capture_output=True,
            text=True,
            timeout=8,
        )
    except FileNotFoundError as error:
        raise TouchpadError("hyprctl is not installed or is not on PATH") from error
    except subprocess.TimeoutExpired as error:
        raise TouchpadError("Hyprland did not respond in time") from error

    if completed.returncode != 0:
        detail = completed.stderr.strip() or completed.stdout.strip() or "unknown error"
        raise TouchpadError(f"hyprctl failed: {detail}")
    return completed.stdout


def json_from_hypr(*args: str) -> Any:
    raw = run_hypr("-j", *args)
    try:
        return json.loads(raw)
    except json.JSONDecodeError as error:
        raise TouchpadError("Hyprland returned invalid JSON") from error


def is_touchpad_name(name: str) -> bool:
    lowered = name.casefold()
    return any(token in lowered for token in ("touchpad", "trackpad", "clickpad"))


def human_device_name(name: str) -> str:
    words = re.sub(r"[-_:]+", " ", name).split()
    return " ".join(word.upper() if len(word) <= 3 else word.title() for word in words)


def list_touchpads() -> list[dict[str, Any]]:
    payload = json_from_hypr("devices")
    devices: list[dict[str, Any]] = []
    for mouse in payload.get("mice", []):
        name = str(mouse.get("name", "")).strip()
        if not name or not is_touchpad_name(name):
            continue
        try:
            speed = float(mouse.get("defaultSpeed", 0.0))
        except (TypeError, ValueError):
            speed = 0.0
        devices.append(
            {
                "name": name,
                "displayName": human_device_name(name),
                "sensitivity": round(speed, 2),
            }
        )
    return devices


def read_option(path: str, value_type: str, fallback: Any) -> Any:
    try:
        payload = json_from_hypr("getoption", path)
        if value_type == "bool":
            return bool(payload["bool"])
        if value_type == "int":
            return int(payload["int"])
        return float(payload["float"])
    except (KeyError, TypeError, ValueError, TouchpadError):
        return fallback


def as_bool(value: Any, fallback: bool) -> bool:
    if isinstance(value, bool):
        return value
    if value in (0, 1):
        return bool(value)
    if isinstance(value, str):
        lowered = value.strip().casefold()
        if lowered in ("true", "1", "yes", "on"):
            return True
        if lowered in ("false", "0", "no", "off"):
            return False
    return fallback


def as_number(value: Any, fallback: float, minimum: float, maximum: float) -> float:
    try:
        number = float(value)
    except (TypeError, ValueError):
        number = fallback
    return max(minimum, min(maximum, number))


def sanitize_settings(values: dict[str, Any]) -> dict[str, Any]:
    result = {
        "disableWhileTyping": as_bool(values.get("disableWhileTyping"), True),
        "naturalScroll": as_bool(values.get("naturalScroll"), False),
        "scrollFactor": round(
            as_number(values.get("scrollFactor"), 0.4, 0.1, 2.0), 2
        ),
        "clickfingerBehavior": as_bool(values.get("clickfingerBehavior"), True),
        "tapToClick": as_bool(values.get("tapToClick"), True),
        "tapAndDrag": as_bool(values.get("tapAndDrag"), True),
        "dragLock": int(round(as_number(values.get("dragLock"), 0, 0, 2))),
        "sensitivity": round(
            as_number(values.get("sensitivity"), 0.0, -1.0, 1.0), 2
        ),
    }

    # Hyprland accepts these combinations, but they cannot produce a useful
    # gesture. Normalizing them keeps the UI and the persisted config honest.
    if not result["tapToClick"]:
        result["tapAndDrag"] = False
    if not result["tapAndDrag"]:
        result["dragLock"] = 0
    return result


def current_settings(devices: list[dict[str, Any]]) -> dict[str, Any]:
    values: dict[str, Any] = {}
    for key, (path, value_type, fallback) in OPTION_SPECS.items():
        values[key] = read_option(path, value_type, fallback)
    values["sensitivity"] = devices[0]["sensitivity"] if devices else 0.0
    return sanitize_settings(values)


def managed_present(path: Path) -> bool:
    try:
        return MANAGED_START in path.read_text(encoding="utf-8")
    except FileNotFoundError:
        return False


def status_payload() -> dict[str, Any]:
    devices = list_touchpads()
    path = input_path()
    sensitivities = {device["sensitivity"] for device in devices}
    return {
        "ok": True,
        "available": bool(devices),
        "devices": devices,
        "mixedSensitivity": len(sensitivities) > 1,
        "values": current_settings(devices),
        "presets": PRESETS,
        "managed": managed_present(path),
        "configPath": str(path),
    }


def lua_bool(value: bool) -> str:
    return "true" if value else "false"


def lua_string(value: str) -> str:
    escaped = (
        value.replace("\\", "\\\\")
        .replace('"', '\\"')
        .replace("\n", "\\n")
        .replace("\r", "\\r")
    )
    return f'"{escaped}"'


def lua_body(values: dict[str, Any], devices: list[dict[str, Any]]) -> str:
    settings = sanitize_settings(values)
    lines = [
        "hl.config({",
        "  input = {",
        "    touchpad = {",
        f"      disable_while_typing = {lua_bool(settings['disableWhileTyping'])},",
        f"      natural_scroll = {lua_bool(settings['naturalScroll'])},",
        f"      scroll_factor = {settings['scrollFactor']:.2f},",
        f"      clickfinger_behavior = {lua_bool(settings['clickfingerBehavior'])},",
        f"      tap_to_click = {lua_bool(settings['tapToClick'])},",
        f"      tap_and_drag = {lua_bool(settings['tapAndDrag'])},",
        f"      drag_lock = {settings['dragLock']},",
        "    },",
        "  },",
        "})",
    ]
    for device in devices:
        lines.append(
            "hl.device({ "
            f"name = {lua_string(device['name'])}, "
            f"sensitivity = {settings['sensitivity']:.2f} "
            "})"
        )
    return "\n".join(lines)


def managed_block(values: dict[str, Any], devices: list[dict[str, Any]]) -> str:
    return (
        f"{MANAGED_START}\n"
        "-- Edit these values through the panel so live preview and rollback stay in sync.\n"
        f"{lua_body(values, devices)}\n"
        f"{MANAGED_END}\n"
    )


def replace_managed_block(content: str, replacement: str | None) -> str:
    starts = content.count(MANAGED_START)
    ends = content.count(MANAGED_END)
    if starts != ends or starts > 1:
        raise TouchpadError(
            "input.lua contains a malformed or duplicated eipi10.touchpad block"
        )

    if starts == 1:
        pattern = re.compile(
            re.escape(MANAGED_START) + r".*?" + re.escape(MANAGED_END) + r"\n?",
            re.DOTALL,
        )
        updated = pattern.sub(replacement or "", content, count=1)
    elif replacement:
        prefix = content.rstrip()
        updated = f"{prefix}\n\n{replacement}" if prefix else replacement
    else:
        updated = content
    return updated.rstrip() + "\n" if updated.strip() else ""


def actual_write_path(path: Path) -> Path:
    return path.resolve() if path.is_symlink() else path


def atomic_write(path: Path, content: str) -> None:
    target = actual_write_path(path)
    target.parent.mkdir(parents=True, exist_ok=True)
    old_mode = target.stat().st_mode & 0o777 if target.exists() else 0o644
    handle, temporary_name = tempfile.mkstemp(
        prefix=f".{target.name}.", dir=target.parent, text=True
    )
    temporary = Path(temporary_name)
    try:
        with os.fdopen(handle, "w", encoding="utf-8") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, old_mode)
        os.replace(temporary, target)
    finally:
        temporary.unlink(missing_ok=True)


def validate_reload(path: Path, original: str) -> None:
    try:
        run_hypr("reload")
        errors = run_hypr("configerrors").strip()
        if errors:
            raise TouchpadError(f"Hyprland rejected the config: {errors}")
    except TouchpadError:
        atomic_write(path, original)
        try:
            run_hypr("reload")
        except TouchpadError:
            pass
        raise


def preview(values: dict[str, Any]) -> dict[str, Any]:
    devices = list_touchpads()
    if not devices:
        raise TouchpadError("No touchpad was detected")
    settings = sanitize_settings(values)
    run_hypr("eval", lua_body(settings, devices))
    return {
        "ok": True,
        "status": "previewed",
        "available": True,
        "devices": devices,
        "values": settings,
    }


def persist(values: dict[str, Any]) -> dict[str, Any]:
    devices = list_touchpads()
    if not devices:
        raise TouchpadError("No touchpad was detected")

    path = input_path()
    target = actual_write_path(path)
    original = target.read_text(encoding="utf-8") if target.exists() else ""
    settings = sanitize_settings(values)
    updated = replace_managed_block(original, managed_block(settings, devices))

    backup = path.with_name(f"{path.name}.eipi10-touchpad.bak")
    if MANAGED_START not in original and not backup.exists():
        backup.parent.mkdir(parents=True, exist_ok=True)
        if target.exists():
            shutil.copy2(target, backup)
        else:
            atomic_write(backup, "")

    atomic_write(path, updated)
    validate_reload(path, original)
    return {
        "ok": True,
        "status": "saved",
        "available": True,
        "devices": devices,
        "values": settings,
        "managed": True,
        "configPath": str(path),
        "backupPath": str(backup),
    }


def reset() -> dict[str, Any]:
    path = input_path()
    target = actual_write_path(path)
    original = target.read_text(encoding="utf-8") if target.exists() else ""
    if MANAGED_START not in original:
        payload = status_payload()
        payload["status"] = "unchanged"
        return payload

    updated = replace_managed_block(original, None)
    atomic_write(path, updated)
    validate_reload(path, original)
    payload = status_payload()
    payload["status"] = "reset"
    payload["managed"] = False
    return payload


def parse_values(raw: str) -> dict[str, Any]:
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError as error:
        raise TouchpadError("Settings payload is not valid JSON") from error
    if not isinstance(payload, dict):
        raise TouchpadError("Settings payload must be a JSON object")
    return payload


def emit(payload: dict[str, Any]) -> None:
    print(json.dumps(payload, ensure_ascii=False, separators=(",", ":")))


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Control Omarchy touchpad settings")
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("status", help="Read devices and effective settings")

    for command in ("preview", "apply"):
        child = subparsers.add_parser(command)
        child.add_argument("--json", required=True, dest="values")

    subparsers.add_parser("reset", help="Remove only the plugin-managed config block")
    presets = subparsers.add_parser("presets", help="Print built-in preset values")
    presets.add_argument("--pretty", action="store_true")
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        if args.command == "status":
            emit(status_payload())
        elif args.command == "preview":
            emit(preview(parse_values(args.values)))
        elif args.command == "apply":
            emit(persist(parse_values(args.values)))
        elif args.command == "reset":
            emit(reset())
        elif args.command == "presets":
            if args.pretty:
                print(json.dumps(PRESETS, ensure_ascii=False, indent=2))
            else:
                emit({"ok": True, "presets": PRESETS})
        return 0
    except TouchpadError as error:
        emit({"ok": False, "error": str(error)})
        return 1
    except Exception as error:  # Defensive boundary: QML must always get JSON.
        emit({"ok": False, "error": f"Unexpected error: {error}"})
        return 1


if __name__ == "__main__":
    sys.exit(main())
