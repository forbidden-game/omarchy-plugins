def _load_oauth_credentials():
    cid = os.environ.get("ANTIGRAVITY_CLIENT_ID", "")
    sec = os.environ.get("ANTIGRAVITY_CLIENT_SECRET", "")
    if not (cid and sec) and OAUTH_CONFIG_FILE.exists():
        try:
            with open(OAUTH_CONFIG_FILE) as f:
                cfg = json.load(f)
                cid = cid or cfg.get("client_id", "")
                sec = sec or cfg.get("client_secret", "")
        except Exception:
            pass
    return cid, sec


CLIENT_ID, CLIENT_SECRET = _load_oauth_credentials()
