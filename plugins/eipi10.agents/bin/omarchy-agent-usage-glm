#!/usr/bin/env python3
#
# omarchy-agent-usage-glm - local usage collector for the GLM Coding Plan
#
# Parses ZCode model I/O session logs ($HOME/.zcode/cli/rollout/*.jsonl)
# and prints one agent usage record on stdout, following the same contract
# as the codex collector. Token accounting comes entirely from local logs;
# plan entitlement comes from ZCode's own coding-plan cache. Live quota
# percentages need an authenticated endpoint ZCode keeps encrypted, so
# "limits" stays empty until such a source becomes available.

import glob
import json
import os
import sys
import urllib.request
from collections import defaultdict
from datetime import date, datetime, timedelta, timezone

HOME = os.environ.get("HOME", "")
ROLLOUT_DIR = os.path.join(HOME, ".zcode/cli/rollout")
PLAN_CACHE = os.path.join(HOME, ".zcode/v2/coding-plan-cache.json")
CONFIG_FILE = os.path.join(HOME, ".config/omarchy/agents/glm.json")
BUSINESS_BASE = os.environ.get("GLM_BUSINESS_BASE_URL", "https://open.bigmodel.cn")
QUOTA_URL = BUSINESS_BASE + "/api/monitor/usage/quota/limit"
SUBSCRIPTION_URL = BUSINESS_BASE + "/api/biz/subscription/list"
PROVIDER_MARKER = "bigmodel"

ZERO_SPLIT = {"inputTokens": 0, "outputTokens": 0, "cacheReadInputTokens": 0, "cacheCreationInputTokens": 0}


def iso_now():
    return datetime.now(timezone.utc).isoformat()


def event_day(line):
    """Local calendar day of an event whose completedAt ends in Z."""
    try:
        ts = line["completedAt"]
        return datetime.fromisoformat(ts.replace("Z", "+00:00")).astimezone().date()
    except (KeyError, AttributeError, ValueError):
        return None


def load_api_key():
    for name in ("GLM_API_KEY", "BIGMODEL_API_KEY", "ZHIPU_API_KEY"):
        value = os.environ.get(name, "").strip()
        if value:
            return value
    try:
        with open(CONFIG_FILE, "r", encoding="utf-8") as handle:
            return str(json.load(handle).get("apiKey", "") or "").strip()
    except (OSError, ValueError, AttributeError):
        return ""


def fetch_json(url, api_key):
    request = urllib.request.Request(
        url,
        headers={"Authorization": "Bearer " + api_key, "Accept": "application/json"},
    )
    try:
        with urllib.request.urlopen(request, timeout=8) as response:
            return json.load(response)
    except (OSError, ValueError):
        return None


def epoch_ms_to_iso(value):
    try:
        moment = datetime.fromtimestamp(int(value) / 1000.0, tz=timezone.utc)
        return moment.isoformat().replace("+00:00", "Z")
    except (OSError, ValueError, OverflowError):
        return ""


def window_title(unit, number):
    if unit == 3:
        return "%d-Hour Window" % number if number != 5 else "5-Hour Window"
    if unit == 6:
        return "Weekly Window" if number == 1 else "%d-Week Window" % number
    return "Usage Window"


def plan_limits(quota):
    """Map the credit-limit windows to the record contract.

    The panel normalizes every limit to a remaining fraction, and treats an
    explicit `remaining` field as authoritative — so emit the remaining
    fraction in both `percent` and `remaining`.
    """
    limits = []
    for raw in ((quota or {}).get("data") or {}).get("limits") or []:
        if not isinstance(raw, dict):
            continue
        total = int(raw.get("usage", 0) or 0)
        left = int(raw.get("remaining", 0) or 0)
        fraction = max(0.0, min(1.0, left / total)) if total > 0 else 0.0
        limits.append({
            "title": window_title(int(raw.get("unit", 0) or 0), int(raw.get("number", 0) or 0)),
            "percent": round(fraction, 4),
            "remaining": round(fraction, 4),
            "resetsAt": epoch_ms_to_iso(raw.get("nextResetTime")),
            "weeklyPercent": None,
            "weeklyResetAt": "",
        })
    return limits


def active_subscription(subscriptions):
    for entry in (subscriptions or {}).get("data") or []:
        if isinstance(entry, dict) and str(entry.get("status", "")) == "VALID":
            return entry
    return None


def looks_like_plan_event(raw):
    return PROVIDER_MARKER in raw or '"GLM-' in raw


def main():
    # Wrapper flags like --force are accepted and ignored: scanning logs is
    # cheap enough that limits-only would save nothing meaningful.
    today = date.today()
    week_days = [today - timedelta(days=offset) for offset in range(6, -1, -1)]
    week_set = set(week_days)

    daily_tokens = defaultdict(int)          # date -> total tokens
    daily_events = defaultdict(int)          # date -> model calls
    today_sessions = set()
    today_split = {}                         # model -> {inputTokens,...}
    today_by_model = defaultdict(int)
    alltime_split = defaultdict(lambda: defaultdict(int))
    alltime_sessions = set()
    alltime_turns = set()
    today_turns = set()
    total_tokens = 0

    paths = sorted(glob.glob(os.path.join(ROLLOUT_DIR, "*.jsonl")))
    for path in paths:
        try:
            with open(path, "r", encoding="utf-8", errors="replace") as handle:
                for blob in handle:
                    if not looks_like_plan_event(blob):
                        continue
                    try:
                        entry = json.loads(blob)
                    except json.JSONDecodeError:
                        continue
                    meta = entry.get("model") or {}
                    provider = str(meta.get("providerId", ""))
                    model = str(meta.get("modelId", ""))
                    if PROVIDER_MARKER not in provider.lower() and not model.lower().startswith("glm"):
                        continue
                    usage = ((entry.get("response") or {}).get("usage")) or {}
                    if not isinstance(usage, dict):
                        continue
                    # Token accounting follows the codex collector: cached
                    # input and cache writes count toward totals too.
                    u_in = int(usage.get("inputTokens", 0) or 0)
                    u_out = int(usage.get("outputTokens", 0) or 0)
                    u_cache_read = int(usage.get("cacheReadTokens", 0) or 0)
                    u_cache_write = int(usage.get("cacheWriteTokens", 0) or 0)
                    tokens = u_in + u_out + u_cache_read + u_cache_write
                    session_id = entry.get("sessionId")
                    if session_id:
                        alltime_sessions.add(str(session_id))
                    # One user turn fans out into many model calls inside the
                    # agent loop — a prompt is the turn, not the call.
                    turn_id = entry.get("turnId")
                    if turn_id:
                        alltime_turns.add(str(turn_id))
                        if day == today:
                            today_turns.add(str(turn_id))
                    day = event_day(entry)
                    if day is None:
                        continue
                    daily_tokens[day] += tokens
                    daily_events[day] += 1
                    total_tokens += tokens
                    alltime_split[model]["inputTokens"] += u_in
                    alltime_split[model]["outputTokens"] += u_out
                    alltime_split[model]["cacheReadInputTokens"] += u_cache_read
                    alltime_split[model]["cacheCreationInputTokens"] += u_cache_write
                    if day == today:
                        if session_id:
                            today_sessions.add(str(session_id))
                        today_by_model[model] += tokens
                        bucket = today_split.setdefault(model, dict(ZERO_SPLIT))
                        bucket["inputTokens"] += u_in
                        bucket["outputTokens"] += u_out
                        bucket["cacheReadInputTokens"] += u_cache_read
                        bucket["cacheCreationInputTokens"] += u_cache_write
        except OSError:
            continue

    status = ""
    cache_help = ""
    entitled = False
    try:
        with open(PLAN_CACHE, "r", encoding="utf-8") as handle:
            item = json.load(handle)["entryStatus"]["items"].get("builtin:bigmodel-coding-plan", {})
        status = str(item.get("status", ""))
        reason = str(item.get("reason", ""))
        if status == "available":
            entitled = True
        elif reason == "coding_plan_not_authenticated":
            cache_help = "Sign in to ZCode so the plan status refreshes."
        elif reason:
            cache_help = "Plan status: %s" % reason.replace("_", " ")
    except (OSError, ValueError, KeyError, TypeError):
        cache_help = "Could not read ZCode's coding-plan cache."

    # Live plan data: plain API key from env or ~/.config/omarchy/agents/glm.json
    api_key = load_api_key()
    limits = []
    tier = ""
    quota_error = ""
    if api_key:
        quota = fetch_json(QUOTA_URL, api_key)
        limits = plan_limits(quota)
        subscription = active_subscription(fetch_json(SUBSCRIPTION_URL, api_key))
        if subscription:
            tier = str(subscription.get("productName", "") or "")
        if not limits:
            quota_error = "Quota endpoint returned no limits"
    else:
        quota_error = "No API key configured"

    help_text = cache_help
    if not api_key:
        help_text = (help_text + " " if help_text else "") + "Add apiKey to ~/.config/omarchy/agents/glm.json"
    elif quota_error and not entitled:
        help_text = quota_error

    plan_ready = bool(limits) or entitled
    record = {
        "schemaVersion": 1,
        "id": "glm",
        "name": "GLM Coding Plan",
        "updatedAt": iso_now(),
        "ready": plan_ready,
        "hasLocalStats": bool(daily_events),
        "tierLabel": tier or ("GLM Coding Plan" if plan_ready else ""),
        "limits": limits,
        "usageStatusText": "" if limits or not api_key else quota_error,
        "authHelpText": help_text,
        "todayPrompts": len(today_turns),
        "todaySessions": len(today_sessions),
        "todayTotalTokens": daily_tokens.get(today, 0),
        "todayTokensByModel": dict(today_by_model),
        "todayModelUsage": today_split,
        "recentDays": [
            {"date": day.isoformat(), "messageCount": daily_tokens.get(day, 0)}
            for day in week_days
        ],
        "totalPrompts": len(alltime_turns),
        "totalSessions": len(alltime_sessions),
        "totalTokens": total_tokens,
        "activeDays": len(daily_tokens),
        "activeDates": [day.isoformat() for day in sorted(daily_tokens)],
        "modelUsage": {model: dict(buckets) for model, buckets in alltime_split.items()},
    }
    json.dump(record, sys.stdout, separators=(",", ":"))
    sys.stdout.write("\n")


if __name__ == "__main__":
    main()
