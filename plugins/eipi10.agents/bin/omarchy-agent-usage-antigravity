#!/usr/bin/python3
# omarchy:summary=Print Antigravity quota and multi-account state as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect Antigravity quota and account state into one display-ready record.

The Codex collector owns the single machine-wide transcript dataset. Keeping
usage out of this record prevents Codex, pi/omp, opencode, and agy sessions
from being counted a second time merely because Antigravity has its own tab.
"""

import argparse
import json
import shutil
import subprocess
import time
from datetime import datetime, timezone
from pathlib import Path

AGENT_ID = "antigravity"
AGENT_NAME = "Antigravity"
AUTH_HELP = "Add an account or run Antigravity to authenticate."

HOME = Path.home()
ANTIGRAVITY_DIR = HOME / ".config" / "omarchy" / "agents" / "antigravity"
ACCOUNTS_INDEX = ANTIGRAVITY_DIR / "accounts.json"
ACCOUNTS_DIR = ANTIGRAVITY_DIR / "accounts"
LEGACY_DIR = HOME / ".antigravity_tools"


def ensure_antigravity_storage():
    """Ensure independent storage exists and auto-migrate legacy data."""
    ANTIGRAVITY_DIR.mkdir(parents=True, exist_ok=True)
    ACCOUNTS_DIR.mkdir(parents=True, exist_ok=True)
    if ACCOUNTS_INDEX.is_file():
        return

    legacy_index = LEGACY_DIR / "accounts.json"
    legacy_accounts = LEGACY_DIR / "accounts"
    if not legacy_index.is_file():
        return
    try:
        shutil.copy2(legacy_index, ACCOUNTS_INDEX)
        if legacy_accounts.is_dir():
            for account_file in legacy_accounts.glob("*.json"):
                shutil.copy2(account_file, ACCOUNTS_DIR / account_file.name)
    except OSError:
        pass


def empty_account_state(status, help_text=AUTH_HELP):
    return {
        "ready": False,
        "currentAccountId": "",
        "currentAccountEmail": "",
        "tierLabel": "",
        "accounts": [],
        "limits": [],
        "usageStatusText": status,
        "authHelpText": help_text,
    }


def refresh_accounts_if_needed(current_account_id, force):
    ctl_bin = Path(__file__).resolve().parent / "omarchy-antigravity-ctl"
    if not ctl_bin.is_file():
        return

    needs_refresh = force
    if not needs_refresh:
        current_file = ACCOUNTS_DIR / f"{current_account_id}.json"
        if current_file.is_file():
            try:
                current_data = json.loads(current_file.read_text(encoding="utf-8"))
                last_updated = int(((current_data.get("quota") or {}).get("last_updated")) or 0)
                needs_refresh = (int(time.time()) - last_updated) > 60
            except (OSError, ValueError, TypeError):
                needs_refresh = True

    if needs_refresh:
        try:
            subprocess.run(
                [str(ctl_bin), "refresh"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=12,
                check=False,
            )
        except (OSError, subprocess.TimeoutExpired):
            pass


def read_account(stub):
    account_id = str(stub.get("id") or "")
    if not account_id:
        return "", {}

    account_file = ACCOUNTS_DIR / f"{account_id}.json"
    try:
        return account_id, json.loads(account_file.read_text(encoding="utf-8"))
    except (OSError, ValueError, TypeError):
        return account_id, {}


def quota_windows(quota):
    windows = {
        "gemini5h": None,
        "gemini5hReset": "",
        "geminiWeekly": None,
        "geminiWeeklyReset": "",
        "claude5h": None,
        "claude5hReset": "",
        "claudeWeekly": None,
        "claudeWeeklyReset": "",
    }
    for group in quota.get("quota_groups") or []:
        group_name = str(group.get("display_name") or "").lower()
        for bucket in group.get("buckets") or []:
            window = str(bucket.get("window") or "").lower()
            bucket_id = str(bucket.get("bucket_id") or "").lower()
            remaining = float(
                bucket.get("remaining_fraction")
                if bucket.get("remaining_fraction") is not None
                else 1.0
            )
            reset_at = str(bucket.get("reset_time") or "")
            is_weekly = "week" in window or "week" in bucket_id
            is_five_hour = "5h" in window or "5h" in bucket_id

            if "gemini" in group_name or "gemini" in bucket_id:
                if is_weekly:
                    windows["geminiWeekly"] = remaining
                    windows["geminiWeeklyReset"] = reset_at
                elif is_five_hour:
                    windows["gemini5h"] = remaining
                    windows["gemini5hReset"] = reset_at
            elif "claude" in group_name or "gpt" in group_name or "3p" in bucket_id:
                if is_weekly:
                    windows["claudeWeekly"] = remaining
                    windows["claudeWeeklyReset"] = reset_at
                elif is_five_hour:
                    windows["claude5h"] = remaining
                    windows["claude5hReset"] = reset_at
    return windows


def model_remaining(quota):
    remaining = {
        "gemini": None,
        "geminiReset": "",
        "claude": None,
        "claudeReset": "",
    }
    for model in quota.get("models") or []:
        name = str(model.get("name") or "").lower()
        fraction = float(
            model.get("percentage")
            if model.get("percentage") is not None
            else 100
        ) / 100.0
        reset_at = str(model.get("reset_time") or "")
        if "gemini-3.7-flash" in name or "gemini-3-flash" in name or "gemini-2.5-flash" in name:
            if (
                remaining["gemini"] is None
                or fraction < remaining["gemini"]
                or not remaining["geminiReset"]
            ):
                remaining["gemini"] = fraction
                remaining["geminiReset"] = reset_at
        elif "opus" in name or "claude" in name or "sonnet" in name:
            if (
                remaining["claude"] is None
                or fraction < remaining["claude"]
                or not remaining["claudeReset"]
            ):
                remaining["claude"] = fraction
                remaining["claudeReset"] = reset_at
    return remaining


def account_view(stub, account_id, account_data, current_account_id):
    quota = account_data.get("quota") or {}
    windows = quota_windows(quota)
    models = model_remaining(quota)
    gemini_five_hour = (
        windows["gemini5h"]
        if windows["gemini5h"] is not None
        else (models["gemini"] if models["gemini"] is not None else 1.0)
    )
    claude_five_hour = (
        windows["claude5h"]
        if windows["claude5h"] is not None
        else (models["claude"] if models["claude"] is not None else 1.0)
    )
    email = str(account_data.get("email") or stub.get("email") or "")
    is_current = account_id == current_account_id
    view = {
        "id": account_id,
        "email": email,
        "name": str(account_data.get("name") or stub.get("name") or email),
        "isCurrent": is_current,
        "flashQuota": round(gemini_five_hour * 100),
        "flashResetAt": windows["gemini5hReset"] or models["geminiReset"],
        "geminiWeeklyPercent": windows["geminiWeekly"],
        "geminiWeeklyResetAt": windows["geminiWeeklyReset"],
        "claudeWeeklyPercent": windows["claudeWeekly"],
        "claudeWeeklyResetAt": windows["claudeWeeklyReset"],
        "tier": str(quota.get("subscription_tier") or ""),
        "disabled": bool(stub.get("disabled") or account_data.get("disabled")),
        "lastUsed": int(stub.get("last_used") or 0),
    }
    limits = []
    if is_current:
        limits = [
            {
                "title": "Gemini 3.7 Flash",
                "percent": gemini_five_hour,
                "remaining": gemini_five_hour,
                "resetsAt": windows["gemini5hReset"] or models["geminiReset"],
                "weeklyPercent": (
                    windows["geminiWeekly"]
                    if windows["geminiWeekly"] is not None
                    else 1.0
                ),
                "weeklyResetAt": windows["geminiWeeklyReset"],
            },
            {
                "title": "Claude Opus 4.6",
                "percent": claude_five_hour,
                "remaining": claude_five_hour,
                "resetsAt": windows["claude5hReset"] or models["claudeReset"],
                "weeklyPercent": (
                    windows["claudeWeekly"]
                    if windows["claudeWeekly"] is not None
                    else 1.0
                ),
                "weeklyResetAt": windows["claudeWeeklyReset"],
            },
        ]
    return view, limits


def load_antigravity_accounts(force=False):
    """Load all accounts and quotas from the independent account store."""
    ensure_antigravity_storage()
    if not ACCOUNTS_INDEX.is_file():
        return empty_account_state("No accounts configured")

    try:
        index_data = json.loads(ACCOUNTS_INDEX.read_text(encoding="utf-8"))
        current_account_id = str(index_data.get("current_account_id") or "")
        account_stubs = index_data.get("accounts") or []
    except (OSError, ValueError, TypeError) as exc:
        return empty_account_state(f"Error reading accounts: {exc}")

    refresh_accounts_if_needed(current_account_id, force)
    accounts = []
    limits = []
    current_tier = ""
    for stub in account_stubs:
        account_id, account_data = read_account(stub)
        if not account_id:
            continue
        view, account_limits = account_view(
            stub,
            account_id,
            account_data,
            current_account_id,
        )
        accounts.append(view)
        if view["isCurrent"]:
            current_tier = view["tier"] or "Google AI Pro"
            limits = account_limits

    current_email = next(
        (account["email"] for account in accounts if account["isCurrent"]),
        "",
    )
    return {
        "ready": bool(accounts),
        "currentAccountId": current_account_id,
        "currentAccountEmail": current_email,
        "tierLabel": current_tier or "Google AI Pro",
        "accounts": accounts,
        "limits": limits,
        "usageStatusText": "",
        "authHelpText": AUTH_HELP,
    }


def empty_usage():
    return {
        "todayPrompts": 0,
        "todaySessions": 0,
        "todayTotalTokens": 0,
        "todayTokensByModel": {},
        "todayModelUsage": {},
        "recentDays": [],
        "totalPrompts": 0,
        "totalSessions": 0,
        "activeDays": 0,
        "activeDates": [],
        "modelUsage": {},
    }


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--limits-only", action="store_true")
    args = parser.parse_args()

    accounts_state = load_antigravity_accounts(force=args.force)
    record = {
        "schemaVersion": 1,
        "id": AGENT_ID,
        "name": AGENT_NAME,
        "updatedAt": datetime.now(timezone.utc).isoformat(),
        "ready": accounts_state.get("ready", True),
        "hasLocalStats": False,
        "hasPromptStats": False,
        "contributesUsage": False,
        "tierLabel": accounts_state.get("tierLabel", "Google AI Pro"),
        "currentAccountId": accounts_state.get("currentAccountId", ""),
        "currentAccountEmail": accounts_state.get("currentAccountEmail", ""),
        "accounts": accounts_state.get("accounts", []),
        "limits": accounts_state.get("limits", []),
        "usageStatusText": accounts_state.get("usageStatusText", ""),
        "authHelpText": accounts_state.get("authHelpText", AUTH_HELP),
    }
    record.update(empty_usage())
    print(json.dumps(record, separators=(",", ":")))


if __name__ == "__main__":
    main()
