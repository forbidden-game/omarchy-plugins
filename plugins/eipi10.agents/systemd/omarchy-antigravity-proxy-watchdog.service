[Unit]
Description=Check Omarchy Antigravity proxy authentication health
After=omarchy-antigravity-proxy.service

[Service]
Type=oneshot
ExecStart=%h/.config/omarchy/plugins/eipi10.agents/bin/omarchy-antigravity-ctl proxy-watchdog
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/omarchy/agents/antigravity/proxy
RestrictSUIDSGID=true
LockPersonality=true
