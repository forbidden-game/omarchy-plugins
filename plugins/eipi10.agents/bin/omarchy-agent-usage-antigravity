#!/usr/bin/python3
# omarchy:summary=Print Antigravity usage, quota, and multi-account state as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect Antigravity usage, Gemini 3.7 Flash quota, and account list into one display-ready JSON record.

Local stats scan all native Codex CLI sessions, pi/omp sessions, opencode sessions,
and agy (Antigravity) conversations to form a complete machine-wide model usage record.
Accounts and quota limits come from ~/.antigravity_tools/accounts.json and accounts/*.json.
"""

import argparse
import fcntl
import hashlib
import json
import os
import shutil
import sqlite3
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timedelta, timezone
from pathlib import Path

AGENT_ID = "antigravity"
AGENT_NAME = "Antigravity"
AUTH_HELP = "Add an account or run Antigravity to authenticate."

HOME = Path.home()
ANTIGRAVITY_DIR = HOME / ".config" / "omarchy" / "agents" / "antigravity"
ACCOUNTS_INDEX = ANTIGRAVITY_DIR / "accounts.json"
ACCOUNTS_DIR = ANTIGRAVITY_DIR / "accounts"
LEGACY_DIR = HOME / ".antigravity_tools"
PRICING_CONFIG = HOME / ".config" / "omarchy" / "agents" / "pricing.json"

